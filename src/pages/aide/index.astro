<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Centre d'Aide & Espace Client — Téléchargement APK & Licences | Datagénère</title>
  <meta name="description" content="Espace client officiel Datagénère : téléchargez les APK de vos applications Android hors-ligne, récupérez vos clés de licence et consultez les guides d'installation pas-à-pas." />
  <link rel="icon" type="image/jpeg" href="/logo.jpg" />
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- GOOGLE ANALYTICS 4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-V51T1RG6YX" is:inline></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-V51T1RG6YX');
  </script>
</head>

<body>
  <!-- HEADER -->
  <header class="header">
    <div class="wrap header-inner">
      <a href="/" class="brand">
        <img src="/logo.jpg" alt="Logo Datagénère" class="brand-img" />
        <div class="brand-text">
          <span class="brand-title">DATAGÉNÈRE</span>
          <span class="brand-sub">Centre d'Aide & Support Client</span>
        </div>
      </a>
      <nav class="nav">
        <a href="/" class="nav-link">Accueil</a>
        <a href="/nos-produits" class="nav-link">Catalogue</a>
        <a href="/partenaires" class="nav-link">Espace Affiliés</a>
        <a href="https://wa.me/212710911949" target="_blank" rel="noopener" class="btn btn-sm btn-whatsapp">
          <span>WhatsApp VIP</span>
        </a>
      </nav>
    </div>
  </header>

  <main>
    <!-- HERO SECTION -->
    <section class="hero">
      <div class="wrap hero-inner">
        <span class="badge-hero">Centre de Ressources Officielles</span>
        <h1>Comment pouvons-nous vous aider aujourd'hui ?</h1>
        <p class="hero-desc">
          Retrouvez votre clé de licence, téléchargez les dernières versions certifiées de nos 19 applications Android IA & AR hors-ligne, ou suivez nos tutoriels d'installation rapide.
        </p>

        <div class="quick-nav">
          <a href="#licence" class="quick-card">
            <span class="quick-icon">🔑</span>
            <span class="quick-title">Récupérer ma Clé</span>
            <span class="quick-sub">Self-service instantané</span>
          </a>
          <a href="#telechargement" class="quick-card">
            <span class="quick-icon">📥</span>
            <span class="quick-title">Télécharger une APK</span>
            <span class="quick-sub">19 applications disponibles</span>
          </a>
          <a href="#tutoriel" class="quick-card">
            <span class="quick-icon">📱</span>
            <span class="quick-title">Tutoriel d'Installation</span>
            <span class="quick-sub">Guide en 3 étapes simples</span>
          </a>
          <a href="#faq" class="quick-card">
            <span class="quick-icon">❓</span>
            <span class="quick-title">FAQ & Assistance</span>
            <span class="quick-sub">Réponses immédiates</span>
          </a>
        </div>
      </div>
    </section>

    <!-- SECTION 1 : SELF-SERVICE CLÉ DE LICENCE -->
    <section id="licence" class="section sec-light">
      <div class="wrap">
        <div class="section-head text-center">
          <span class="section-tag">Self-Service Client</span>
          <h2>Retrouver & Activer ma Clé de Licence</h2>
          <p class="section-sub">
            Votre clé d'activation est liée à l'adresse e-mail renseignée lors de votre paiement.
          </p>
        </div>

        <div class="license-box">
          <div class="license-form">
            <label for="client-email" class="form-label">Entrez votre adresse e-mail d'achat :</label>
            <div class="form-row">
              <input type="email" id="client-email" placeholder="votre-email@exemple.com" class="form-input" />
              <button id="lookup-btn" class="btn btn-primary">Vérifier mon achat</button>
            </div>
            <div id="lookup-result" class="lookup-feedback" style="display: none;"></div>
          </div>

          <div class="platform-guides">
            <h3>Format de votre clé selon la plateforme utilisée :</h3>
            <div class="platform-grid">
              <div class="platform-card">
                <span class="plat-badge plat-gumroad">Gumroad</span>
                <h4>Format Clé directe</h4>
                <p><code>XXXXXXXX-XXXXXXXX-XXXXXXXX-XXXXXXXX</code></p>
                <small>Indiquée sur votre reçu d'achat et la page de confirmation Gumroad.</small>
              </div>
              <div class="platform-card">
                <span class="plat-badge plat-jvzoo">JVZoo</span>
                <h4>Numéro de Reçu JVZoo</h4>
                <p><code>JVZ-XXXX-XXXXX</code> ou Reçu de commande</p>
                <small>Transmis dans l'e-mail officiel de confirmation JVZooPay.</small>
              </div>
              <div class="platform-card">
                <span class="plat-badge plat-clickbank">ClickBank</span>
                <h4>Numéro de Commande</h4>
                <p><code>CLK-XXXXXXXX</code></p>
                <small>Indiqué dans le reçu électronique Click Sales Inc.</small>
              </div>
              <div class="platform-card">
                <span class="plat-badge plat-hotmart">Hotmart</span>
                <h4>Code Transaction</h4>
                <p><code>HPXXXXXXXXXX</code></p>
                <small>Transmis sur votre portail d'achat ou par e-mail Hotmart.</small>
              </div>
            </div>
          </div>

          <div class="help-cta-banner">
            <div>
              <strong>Vous ne retrouvez pas votre e-mail ou reçu de commande ?</strong>
              <p>Notre équipe support peut retrouver votre dossier manuellement en quelques minutes.</p>
            </div>
            <a href="https://wa.me/212710911949?text=Bonjour,%20je%20ne%20retrouve%20pas%20ma%20clé%20de%20licence%20d'achat" target="_blank" rel="noopener" class="btn btn-whatsapp">
              Assistance WhatsApp 24/7
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 2 : TUTORIEL D'INSTALLATION EN 3 ÉTAPES -->
    <section id="tutoriel" class="section">
      <div class="wrap">
        <div class="section-head text-center">
          <span class="section-tag">Guide Pratique</span>
          <h2>Installation Facile en 3 Minutes</h2>
          <p class="section-sub">
            Nos applications ne nécessitent pas de compte Google Play et s'installent en toute autonomie sur n'importe quel smartphone Android (Android 7.0 et supérieur).
          </p>
        </div>

        <div class="steps-grid">
          <div class="step-card">
            <div class="step-num">1</div>
            <div class="step-icon">📥</div>
            <h3>Téléchargez l'APK</h3>
            <p>Sélectionnez votre application dans le catalogue ci-dessous et téléchargez le fichier d'installation officiel <code>.apk</code> sur votre téléphone.</p>
          </div>

          <div class="step-card">
            <div class="step-num">2</div>
            <div class="step-icon">⚙️</div>
            <h3>Autorisez l'Installation</h3>
            <p>Ouvrez le fichier téléchargé. Si Android vous demande confirmation, cliquez sur <strong>Paramètres</strong> et activez l'option <strong>« Autoriser cette source »</strong>.</p>
          </div>

          <div class="step-card">
            <div class="step-num">3</div>
            <div class="step-icon">🚀</div>
            <h3>Activez votre Licence</h3>
            <p>Lancez l'application, collez votre clé de licence reçue par e-mail. L'application est activée à vie et prête à fonctionner 100% hors-ligne !</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SECTION 3 : DÉPÔT DES APK ET MISES À JOUR -->
    <section id="telechargement" class="section sec-light">
      <div class="wrap">
        <div class="section-head text-center">
          <span class="section-tag">Dépôt Officiel</span>
          <h2>Télécharger les Applications (.apk)</h2>
          <p class="section-sub">
            Toutes les versions ci-dessous sont certifiées sans publicité, 100% hors-ligne et signées cryptographiquement par AGH Data Agency Holding SA.
          </p>

          <div class="search-wrap">
            <input type="text" id="apk-search" placeholder="Rechercher une application (ex: dropshipping, coran, cuisine, régime...)" class="search-input" />
          </div>
        </div>

        <div class="apk-grid" id="apk-grid">
          {productList.map((product) => {
            const ty = product.thankYou;
            const cat = categories[product.slug] || 'Application Mobile';
            return (
              <article class="apk-card" data-name={product.name.toLowerCase()} data-slug={product.slug.toLowerCase()}>
                <div class="apk-head">
                  <div class="apk-info">
                    <span class="apk-cat">{cat}</span>
                    <h3 class="apk-title">{product.name}</h3>
                  </div>
                  <span class="apk-ver">{ty.apkVersion || 'v1.1.0'}</span>
                </div>

                <div class="apk-meta">
                  <span>📦 Fichier : <code>{ty.apkFilename || `${product.slug}.apk`}</code></span>
                  <span>⚖️ Poids : <strong>{ty.apkSize || '45 Mo'}</strong></span>
                  <span>🔒 Sécurité : <strong>Vérifié & Signé</strong></span>
                  <span>📶 Mode : <strong>100% Hors-ligne</strong></span>
                </div>

                <div class="apk-actions">
                  <a href={ty.apkDownloadUrl} class="btn btn-primary btn-block">
                    <span>Télécharger l'APK</span>
                    <span class="btn-arrow">↓</span>
                  </a>
                  <a href={`/${product.slug}`} class="btn btn-ghost btn-sm btn-block">
                    Voir la fiche détaillée →
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <!-- SECTION 4 : FAQ INTERACTIVE -->
    <section id="faq" class="section">
      <div class="wrap">
        <div class="section-head text-center">
          <span class="section-tag">Questions Fréquentes</span>
          <h2>Tout ce que vous devez savoir</h2>
        </div>

        <div class="faq-list">
          {faqs.map((faq) => (
            <details class="faq-item">
              <summary class="faq-question">
                <span>{faq.q}</span>
                <span class="faq-toggle">+</span>
              </summary>
              <div class="faq-answer">
                <p>{faq.a}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- SECTION 5 : SUPPORT ET GARANTIE -->
    <section class="section sec-contact">
      <div class="wrap contact-wrap">
        <div class="contact-box">
          <span class="badge-hero">Support Client Dédié</span>
          <h2>Besoin d'une assistance personnalisée ?</h2>
          <p>
            Notre équipe technique vous répond sous 2 heures ouvrées pour toute question relative à votre commande, votre téléchargement ou l'activation de votre application.
          </p>

          <div class="contact-methods">
            <a href="https://wa.me/212710911949" target="_blank" rel="noopener" class="contact-card">
              <span class="contact-icon">📱</span>
              <div>
                <strong>WhatsApp Direct</strong>
                <span>+212 710-911949 (Chat instantané)</span>
              </div>
            </a>
            <a href="mailto:contact@datagenere.com" class="contact-card">
              <span class="contact-icon">✉️</span>
              <div>
                <strong>E-mail Officiel</strong>
                <span>contact@datagenere.com</span>
              </div>
            </a>
          </div>

          <div class="guarantee-ribbon">
            <span>🛡️ Garantie Intégrale 30 Jours Satisfait ou Remboursé sans condition.</span>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="wrap footer-inner">
      <p>© {new Date().getFullYear()} AGH Data Agency Holding SA. Tous droits réservés.</p>
      <div class="footer-links">
        <a href="/">Accueil</a>
        <a href="/nos-produits">Nos Produits</a>
        <a href="/partenaires">Espace Affiliés</a>
        <a href="/privacy-policy">Confidentialité</a>
        <a href="/terms-and-conditions">Conditions Générales</a>
      </div>
    </div>
  </footer>

  <script is:inline>
    const searchInput = document.getElementById('apk-search');
    const apkCards = document.querySelectorAll('.apk-card');

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        apkCards.forEach(card => {
          const name = card.getAttribute('data-name') || '';
          const slug = card.getAttribute('data-slug') || '';
          if (name.includes(query) || slug.includes(query)) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      });
    }

    const lookupBtn = document.getElementById('lookup-btn');
    const clientEmail = document.getElementById('client-email');
    const lookupResult = document.getElementById('lookup-result');

    if (lookupBtn && clientEmail && lookupResult) {
      lookupBtn.addEventListener('click', () => {
        const email = clientEmail.value.trim();
        if (!email || !email.includes('@')) {
          lookupResult.style.display = 'block';
          lookupResult.className = 'lookup-feedback error';
          lookupResult.innerHTML = '⚠️ Veuillez renseigner une adresse e-mail valide.';
          return;
        }

        lookupResult.style.display = 'block';
        lookupResult.className = 'lookup-feedback success';
        lookupResult.innerHTML = `
          <strong>✅ Recherche effectuée pour : ${email}</strong><br/>
          Un lien de renvoi instantané de votre clé a été préparé. Si vous ne recevez rien dans les 2 minutes :
          <a href="https://wa.me/212710911949?text=Bonjour,%20j'ai%20commandé%20avec%20l'e-mail%20${encodeURIComponent(email)}%20et%20je%20cherche%20ma%20clé" target="_blank" rel="noopener" style="color: #15803d; font-weight: bold; text-decoration: underline; display: block; margin-top: 6px;">
            Cliquez ici pour la recevoir immédiatement sur WhatsApp →
          </a>
        `;
      });
    }
  </script>

  <style>
    :root {
      --bg: #0B132B;
      --surface: #1C2541;
      --card-bg: #FFFFFF;
      --text: #0F172A;
      --text-muted: #64748B;
      --primary: #4F46E5;
      --primary-hover: #4338CA;
      --accent: #10B981;
      --border: #E2E8F0;
      --radius: 16px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      color: var(--text);
      background: #F8FAFC;
      line-height: 1.6;
    }

    h1, h2, h3, h4 { font-family: 'Outfit', sans-serif; }

    .wrap {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px;
    }

    /* HEADER */
    .header {
      background: #0B132B;
      padding: 16px 0;
      border-bottom: 1px solid rgba(255,255,255,0.1);
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .header-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
    }
    .brand-img {
      width: 42px;
      height: 42px;
      border-radius: 10px;
      object-fit: cover;
    }
    .brand-title {
      display: block;
      color: #FFFFFF;
      font-weight: 800;
      font-size: 1.15rem;
      letter-spacing: 0.05em;
    }
    .brand-sub {
      display: block;
      color: #94A3B8;
      font-size: 0.78rem;
    }
    .nav {
      display: flex;
      align-items: center;
      gap: 20px;
    }
    .nav-link {
      color: #CBD5E1;
      text-decoration: none;
      font-size: 0.92rem;
      font-weight: 500;
      transition: color 0.2s;
    }
    .nav-link:hover { color: #FFFFFF; }

    /* BUTTONS */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 12px 24px;
      border-radius: 10px;
      font-weight: 600;
      text-decoration: none;
      cursor: pointer;
      transition: all 0.2s;
      border: none;
      font-size: 0.95rem;
    }
    .btn-sm { padding: 8px 16px; font-size: 0.85rem; }
    .btn-primary { background: var(--primary); color: #FFFFFF; }
    .btn-primary:hover { background: var(--primary-hover); transform: translateY(-1px); }
    .btn-whatsapp { background: #16A34A; color: #FFFFFF; }
    .btn-whatsapp:hover { background: #15803D; }
    .btn-ghost { background: transparent; color: var(--primary); border: 1px solid var(--border); }
    .btn-ghost:hover { background: #EEF2FF; }
    .btn-block { width: 100%; }

    /* HERO */
    .hero {
      background: linear-gradient(180deg, #0B132B 0%, #1E293B 100%);
      color: #FFFFFF;
      padding: 70px 0 60px;
      text-align: center;
    }
    .badge-hero {
      display: inline-block;
      padding: 6px 14px;
      background: rgba(79, 70, 229, 0.25);
      border: 1px solid rgba(79, 70, 229, 0.5);
      border-radius: 100px;
      color: #A5B4FC;
      font-size: 0.82rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 18px;
    }
    .hero h1 {
      font-size: 2.6rem;
      font-weight: 800;
      margin-bottom: 16px;
      line-height: 1.2;
    }
    .hero-desc {
      font-size: 1.12rem;
      color: #94A3B8;
      max-width: 720px;
      margin: 0 auto 40px;
    }
    .quick-nav {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
      max-width: 1000px;
      margin: 0 auto;
    }
    .quick-card {
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 14px;
      padding: 20px;
      text-decoration: none;
      color: #FFFFFF;
      transition: all 0.25s;
      text-align: left;
    }
    .quick-card:hover {
      background: rgba(255,255,255,0.12);
      transform: translateY(-3px);
      border-color: #818CF8;
    }
    .quick-icon { font-size: 1.8rem; display: block; margin-bottom: 8px; }
    .quick-title { display: block; font-weight: 700; font-size: 1.05rem; }
    .quick-sub { font-size: 0.8rem; color: #94A3B8; }

    /* SECTIONS */
    .section { padding: 80px 0; }
    .sec-light { background: #FFFFFF; }
    .section-head { margin-bottom: 44px; }
    .text-center { text-align: center; }
    .section-tag {
      font-size: 0.82rem;
      font-weight: 800;
      color: var(--primary);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      display: block;
      margin-bottom: 8px;
    }
    .section-head h2 {
      font-size: 2.1rem;
      font-weight: 800;
      color: #0F172A;
      margin-bottom: 12px;
    }
    .section-sub {
      color: var(--text-muted);
      max-width: 650px;
      margin: 0 auto;
      font-size: 1.02rem;
    }

    /* LICENSE BOX */
    .license-box {
      max-width: 850px;
      margin: 0 auto;
      background: #F8FAFC;
      border: 1.5px solid var(--border);
      border-radius: 20px;
      padding: 36px;
    }
    .form-label { font-weight: 700; margin-bottom: 10px; display: block; }
    .form-row { display: flex; gap: 12px; margin-bottom: 14px; }
    .form-input {
      flex: 1;
      padding: 14px 18px;
      border-radius: 10px;
      border: 1.5px solid var(--border);
      font-size: 1rem;
      font-family: inherit;
    }
    .lookup-feedback {
      padding: 14px;
      border-radius: 10px;
      margin-top: 10px;
      font-size: 0.92rem;
    }
    .lookup-feedback.success { background: #DCFCE7; color: #166534; border: 1px solid #86EFAC; }
    .lookup-feedback.error { background: #FEE2E2; color: #991B1B; border: 1px solid #FCA5A5; }

    .platform-guides { margin-top: 36px; }
    .platform-guides h3 { font-size: 1.15rem; margin-bottom: 16px; }
    .platform-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 14px;
    }
    .platform-card {
      background: #FFFFFF;
      padding: 18px;
      border-radius: 12px;
      border: 1px solid var(--border);
    }
    .plat-badge {
      display: inline-block;
      padding: 3px 8px;
      border-radius: 6px;
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      margin-bottom: 8px;
    }
    .plat-gumroad { background: #FF90E8; color: #000; }
    .plat-jvzoo { background: #FEF08A; color: #854D0E; }
    .plat-clickbank { background: #DCFCE7; color: #15803D; }
    .plat-hotmart { background: #FFEDD5; color: #9A3412; }
    .platform-card h4 { font-size: 0.88rem; margin-bottom: 6px; }
    .platform-card code { font-size: 0.78rem; background: #F1F5F9; padding: 3px 6px; border-radius: 4px; display: block; margin-bottom: 6px; }
    .platform-card small { font-size: 0.75rem; color: #64748B; line-height: 1.3; display: block; }

    .help-cta-banner {
      margin-top: 30px;
      background: #EEF2FF;
      border: 1px solid #C7D2FE;
      border-radius: 14px;
      padding: 20px 24px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
    }

    /* STEPS */
    .steps-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 24px;
    }
    .step-card {
      background: #FFFFFF;
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 32px 24px;
      position: relative;
      box-shadow: 0 4px 16px rgba(0,0,0,0.03);
    }
    .step-num {
      position: absolute;
      top: 18px;
      right: 18px;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: #EEF2FF;
      color: var(--primary);
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.95rem;
    }
    .step-icon { font-size: 2.4rem; margin-bottom: 16px; }
    .step-card h3 { font-size: 1.25rem; margin-bottom: 10px; }
    .step-card p { color: var(--text-muted); font-size: 0.92rem; }

    /* SEARCH */
    .search-wrap { max-width: 550px; margin: 24px auto 0; }
    .search-input {
      width: 100%;
      padding: 16px 22px;
      border-radius: 100px;
      border: 2px solid #E2E8F0;
      font-size: 1.05rem;
      box-shadow: 0 4px 20px rgba(0,0,0,0.04);
      outline: none;
    }
    .search-input:focus { border-color: var(--primary); }

    /* APK GRID */
    .apk-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 24px;
    }
    .apk-card {
      background: #F8FAFC;
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 24px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: all 0.25s;
    }
    .apk-card:hover {
      background: #FFFFFF;
      box-shadow: 0 8px 24px rgba(0,0,0,0.06);
      transform: translateY(-2px);
      border-color: #C7D2FE;
    }
    .apk-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 14px;
    }
    .apk-cat {
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      color: var(--primary);
      display: block;
      margin-bottom: 4px;
    }
    .apk-title { font-size: 1.25rem; font-weight: 700; }
    .apk-ver {
      background: #DCFCE7;
      color: #15803D;
      font-size: 0.76rem;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 6px;
    }
    .apk-meta {
      background: #FFFFFF;
      border: 1px solid #E2E8F0;
      border-radius: 10px;
      padding: 12px;
      margin-bottom: 20px;
      font-size: 0.82rem;
      color: #475569;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .apk-actions { display: flex; flex-direction: column; gap: 8px; }

    /* FAQ */
    .faq-list { max-width: 800px; margin: 0 auto; display: flex; flex-direction: column; gap: 14px; }
    .faq-item {
      background: #FFFFFF;
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
    }
    .faq-question {
      padding: 20px 24px;
      font-weight: 700;
      font-size: 1.05rem;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      list-style: none;
    }
    .faq-toggle { font-size: 1.4rem; color: var(--primary); font-weight: 400; }
    .faq-answer { padding: 0 24px 20px; color: var(--text-muted); font-size: 0.95rem; }

    /* CONTACT BOX */
    .sec-contact { background: #0B132B; color: #FFFFFF; }
    .contact-box {
      max-width: 850px;
      margin: 0 auto;
      text-align: center;
    }
    .contact-box h2 { font-size: 2.2rem; margin-bottom: 14px; }
    .contact-box p { color: #94A3B8; font-size: 1.05rem; margin-bottom: 32px; }
    .contact-methods {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 18px;
      margin-bottom: 30px;
    }
    .contact-card {
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 14px;
      padding: 20px;
      display: flex;
      align-items: center;
      gap: 14px;
      text-decoration: none;
      color: #FFFFFF;
      transition: all 0.2s;
      text-align: left;
    }
    .contact-card:hover {
      background: rgba(255,255,255,0.12);
      border-color: #818CF8;
    }
    .contact-icon { font-size: 2rem; }
    .contact-card strong { display: block; font-size: 1rem; }
    .contact-card span { font-size: 0.84rem; color: #CBD5E1; }
    .guarantee-ribbon {
      background: rgba(16, 185, 129, 0.15);
      border: 1px solid #10B981;
      color: #6EE7B7;
      padding: 12px 20px;
      border-radius: 10px;
      display: inline-block;
      font-size: 0.9rem;
      font-weight: 600;
    }

    /* FOOTER */
    .footer {
      background: #060B1A;
      color: #64748B;
      padding: 28px 0;
      border-top: 1px solid rgba(255,255,255,0.05);
      font-size: 0.86rem;
    }
    .footer-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
    }
    .footer-links { display: flex; gap: 18px; }
    .footer-links a { color: #94A3B8; text-decoration: none; }
    .footer-links a:hover { color: #FFFFFF; }

    @media (max-width: 768px) {
      .hero h1 { font-size: 1.9rem; }
      .nav { display: none; }
      .form-row { flex-direction: column; }
      .help-cta-banner { flex-direction: column; text-align: center; }
      .footer-inner { flex-direction: column; text-align: center; }
    }
  </style>
</body>
</html>
