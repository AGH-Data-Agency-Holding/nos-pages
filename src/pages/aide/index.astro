import { products } from '../../data/products';

const productList = Object.values(products);

const categories: Record<string, string> = {
  'recettes-cuisine': 'Cuisine & Gastronomie',
  'dropshipping': 'E-Commerce & B2B',
  'apk-regime': 'Santé & Nutrition',
  'ai-doctor': 'Médical & Santé',
  'coiffure-ai': 'Beauté & Coiffure',
  'dresser-ai': 'Mode & Stylisme',
  'esthetique': 'Dermatologie & Soins',
  'examen-assistant': 'Éducation & Études',
  'fitness-coach': 'Sport & Fitness',
  'histoires-prophetes': 'Éducation & Histoire',
  'mental-health': 'Bien-être & Sérénité',
  'my-quran': 'Spiritualité & Tajwid',
  'natural-beauty': 'Beauté Naturelle & Bio',
  'nutrition-kids': 'Petite Enfance & Nutrition',
  'ramadan-halal': 'Spiritualité & Jeûne',
  'ruqya-charia': 'Spiritualité & Protection',
  'salat-hajj': 'Spiritualité & Pèlerinage',
  'smart-deco': 'Design & Intérieur',
  'vape-stopper': 'Santé & Sevrage'
};

const faqs = [
  {
    q: "Où puis-je trouver ma clé de licence après mon achat ?",
    a: "Votre clé de licence vous est transmise instantanément sur la page de remerciement post-achat et par e-mail (vérifiez vos spams). Selon votre plateforme : sur Gumroad, elle se présente sous la forme XXXX-XXXX-XXXX-XXXX ; sur JVZoo, ClickBank ou Hotmart, il s'agit de votre numéro de reçu / code de transaction officiel."
  },
  {
    q: "Les applications fonctionnent-elles vraiment 100% hors-ligne ?",
    a: "Oui, absolument ! Toutes nos applications embarquent leurs propres modèles d'IA et bases de données directement dans le fichier APK. Une fois l'application installée et votre licence activée, aucune connexion Wi-Fi ni données mobiles n'est nécessaire. Vous pouvez les utiliser même en mode avion."
  },
  {
    q: "Pourquoi mon smartphone affiche 'Application de source inconnue' ou un avertissement Play Protect ?",
    a: "C'est une alerte standard d'Android pour tout fichier APK téléchargé directement depuis un site officiel et non depuis le Google Play Store. Nos binaires sont 100% sains, signés cryptographiquement et certifiés sans aucun malware. Il vous suffit de cliquer sur 'Paramètres' puis d'activer 'Autoriser cette source' pour poursuivre l'installation en 10 secondes."
  },
  {
    q: "Sur combien d'appareils puis-je installer ma licence ?",
    a: "Votre clé de licence individuelle vous autorise à installer et activer l'application sur tous vos appareils personnels (smartphone principal, tablette, second téléphone Android)."
  },
  {
    q: "Comment mettre à jour mon application vers la dernière version ?",
    a: "Téléchargez simplement la nouvelle version de l'APK depuis cette page et lancez l'installation sur votre téléphone. Vos données, favoris et progression seront automatiquement conservés sans avoir besoin de ressaisir votre clé."
  },
  {
    q: "Quelle est votre politique de remboursement si je ne suis pas satisfait ?",
    a: "Nous offrons une garantie intégrale 'Satisfait ou Remboursé' sous 30 jours (et 60 jours sur ClickBank). Si l'application ne correspond pas à vos attentes, contactez simplement notre support avec votre e-mail de commande pour obtenir un remboursement complet sans condition."
  }
];
