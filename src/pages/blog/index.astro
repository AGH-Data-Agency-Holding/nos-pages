---
import { blogArticles } from '../../data/blogArticles';

const pageTitle = "Blog & Guides Développement Mobile — AGH Data Agency";
const pageDesc = "Articles techniques, guides tarifaires, comparatifs React Native vs Flutter, architecture offline-first et externalisation mobile par les ingénieurs d'AGH Data Agency.";
const canonicalUrl = "https://datagenere.com/blog";

const allCategories = ["Tous", ...Array.from(new Set(blogArticles.map(a => a.category)))];

const jsonLdBlog = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Blog Technique AGH Data Agency",
  "description": pageDesc,
  "url": canonicalUrl,
  "publisher": {
    "@type": "Organization",
    "name": "AGH Data Agency Holding SA",
    "url": "https://datagenere.com",
    "logo": "https://datagenere.com/logo.jpg"
  },
  "blogPost": blogArticles.map(post => ({
    "@type": "BlogPosting",
    "headline": post.title,
    "description": post.metaDescription,
    "url": `https://datagenere.com/blog/${post.slug}`,
    "datePublished": post.date,
    "author": {
      "@type": "Organization",
      "name": "AGH Data Agency"
    }
  }))
};
---

<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/jpeg" href="/logo.jpg" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:image" content="https://datagenere.com/logo.jpg" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDesc} />
  <meta name="twitter:image" content="https://datagenere.com/logo.jpg" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Schema.org Blog JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdBlog)} />

  <!-- Google Analytics 4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-V51T1RG6YX" is:inline></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-V51T1RG6YX');
  </script>

  <style>
    :root {
      --primary: #4F46E5;
      --primary-hover: #4338CA;
      --primary-light: #EEF2FF;
      --dark: #0B132B;
      --dark-card: #1E293B;
      --text: #1E293B;
      --muted: #64748B;
      --border: #E2E8F0;
      --bg-page: #F8FAFC;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background: var(--bg-page);
      color: var(--text);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }
    h1, h2, h3, h4 {
      font-family: 'Outfit', sans-serif;
      color: var(--dark);
      font-weight: 700;
    }
    a { color: inherit; text-decoration: none; }
    .wrap {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* HEADER */
    .header {
      background: #FFFFFF;
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .header-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      height: 74px;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .brand-img {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      object-fit: cover;
    }
    .brand-title {
      font-weight: 800;
      font-size: 1.15rem;
      letter-spacing: -0.01em;
      color: var(--dark);
      display: block;
      line-height: 1.2;
    }
    .brand-sub {
      font-size: 0.76rem;
      color: var(--muted);
      font-weight: 500;
    }
    .nav {
      display: flex;
      align-items: center;
      gap: 22px;
    }
    .nav-link {
      font-size: 0.92rem;
      font-weight: 600;
      color: #334155;
      transition: color 0.2s;
    }
    .nav-link:hover, .nav-link.active {
      color: var(--primary);
    }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-weight: 700;
      padding: 10px 20px;
      border-radius: 9999px;
      transition: all 0.2s;
      cursor: pointer;
      font-size: 0.9rem;
    }
    .btn-primary {
      background: var(--primary);
      color: #FFFFFF;
      box-shadow: 0 4px 14px rgba(79, 70, 229, 0.35);
    }
    .btn-primary:hover {
      background: var(--primary-hover);
      transform: translateY(-2px);
    }
    .btn-whatsapp {
      background: #16A34A;
      color: #FFFFFF;
    }
    .btn-whatsapp:hover {
      background: #15803D;
    }

    /* HERO */
    .hero {
      background: linear-gradient(180deg, #0B132B 0%, #1E293B 100%);
      color: #FFFFFF;
      padding: 80px 0 60px;
      text-align: center;
    }
    .hero-badge {
      display: inline-block;
      padding: 6px 14px;
      background: rgba(79, 70, 229, 0.25);
      border: 1px solid rgba(79, 70, 229, 0.5);
      border-radius: 100px;
      color: #A5B4FC;
      font-size: 0.82rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 20px;
    }
    .hero h1 {
      font-size: 2.8rem;
      color: #FFFFFF;
      margin-bottom: 18px;
      line-height: 1.2;
    }
    .hero p {
      font-size: 1.15rem;
      color: #94A3B8;
      max-width: 740px;
      margin: 0 auto 36px;
    }

    /* FILTERS */
    .filter-bar {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 10px;
      margin-top: 10px;
    }
    .filter-btn {
      background: rgba(255, 255, 255, 0.08);
      color: #E2E8F0;
      border: 1px solid rgba(255, 255, 255, 0.15);
      padding: 8px 18px;
      border-radius: 9999px;
      font-size: 0.88rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s;
    }
    .filter-btn:hover, .filter-btn.active {
      background: var(--primary);
      color: #FFFFFF;
      border-color: var(--primary);
    }

    /* ARTICLES GRID */
    .articles-section {
      padding: 60px 0 90px;
    }
    .articles-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
      gap: 28px;
    }
    .article-card {
      background: #FFFFFF;
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 28px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
    }
    .article-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 16px 32px rgba(15, 23, 42, 0.08);
      border-color: #CBD5E1;
    }
    .card-top {
      margin-bottom: 16px;
    }
    .card-meta {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
    }
    .card-cat {
      background: var(--primary-light);
      color: var(--primary);
      font-size: 0.78rem;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 8px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .card-time {
      font-size: 0.82rem;
      color: var(--muted);
      font-weight: 500;
    }
    .card-title {
      font-size: 1.28rem;
      line-height: 1.35;
      margin-bottom: 12px;
      color: var(--dark);
      transition: color 0.2s;
    }
    .article-card:hover .card-title {
      color: var(--primary);
    }
    .card-summary {
      font-size: 0.92rem;
      color: #475569;
      line-height: 1.55;
      margin-bottom: 16px;
    }
    .card-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 20px;
    }
    .tag-item {
      font-size: 0.75rem;
      background: #F1F5F9;
      color: #475569;
      padding: 3px 8px;
      border-radius: 6px;
      font-weight: 500;
    }
    .card-footer {
      border-top: 1px solid #F1F5F9;
      padding-top: 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .card-link {
      font-size: 0.9rem;
      font-weight: 700;
      color: var(--primary);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: gap 0.2s;
    }
    .card-link:hover {
      gap: 10px;
    }
    .card-date {
      font-size: 0.8rem;
      color: var(--muted);
    }

    /* CTA BANNER */
    .cta-box {
      background: linear-gradient(135deg, #1E1B4B 0%, #312E81 100%);
      border-radius: 20px;
      padding: 50px 40px;
      color: #FFFFFF;
      margin-top: 60px;
      text-align: center;
      border: 1px solid rgba(255, 255, 255, 0.1);
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
    }
    .cta-box h2 {
      color: #FFFFFF;
      font-size: 2.2rem;
      margin-bottom: 14px;
    }
    .cta-box p {
      font-size: 1.1rem;
      color: #C7D2FE;
      max-width: 680px;
      margin: 0 auto 30px;
    }
    .cta-buttons {
      display: flex;
      justify-content: center;
      gap: 16px;
      flex-wrap: wrap;
    }
    .btn-light {
      background: #FFFFFF;
      color: #1E1B4B;
    }
    .btn-light:hover {
      background: #F8FAFC;
      transform: translateY(-2px);
    }

    /* FOOTER */
    .footer {
      background: #0B132B;
      color: #94A3B8;
      padding: 50px 0 30px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      font-size: 0.88rem;
    }
    .footer-inner {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 20px;
    }
    .footer-links {
      display: flex;
      gap: 24px;
      flex-wrap: wrap;
      justify-content: center;
    }
    .footer-links a:hover {
      color: #FFFFFF;
    }

    @media (max-width: 768px) {
      .hero h1 { font-size: 2.1rem; }
      .articles-grid { grid-template-columns: 1fr; }
      .nav-link { display: none; }
      .cta-box { padding: 36px 20px; }
      .cta-box h2 { font-size: 1.7rem; }
    }
  </style>
</head>

<body>
  <!-- HEADER -->
  <header class="header">
    <div class="wrap header-inner">
      <a href="/" class="brand">
        <img src="/logo.jpg" alt="Logo AGH Data Agency" class="brand-img" />
        <div class="brand-text">
          <span class="brand-title">AGH DATA AGENCY</span>
          <span class="brand-sub">Blog Technique & Guides Mobiles</span>
        </div>
      </a>
      <nav class="nav">
        <a href="/" class="nav-link">Accueil</a>
        <a href="/nos-produits" class="nav-link">Catalogue Apps</a>
        <a href="/blog" class="nav-link active">Blog Tech</a>
        <a href="/aide" class="nav-link">Centre d'Aide</a>
        <a href="/partenaires" class="nav-link">Affiliés</a>
        <a href="https://wa.me/212710911949" target="_blank" rel="noopener" class="btn btn-whatsapp">
          WhatsApp Pro
        </a>
      </nav>
    </div>
  </header>

  <main>
    <!-- HERO -->
    <section class="hero">
      <div class="wrap">
        <span class="hero-badge">Ressources & Ingénierie Mobile 2026</span>
        <h1>Guides Experts en Développement d'Applications Mobiles & IA</h1>
        <p>
          Analyses de coûts, architectures offline-first, comparatifs Flutter vs React Native et stratégies d'outsourcing par les ingénieurs d'AGH Data Agency.
        </p>

        <!-- FILTERS -->
        <div class="filter-bar" id="filter-container">
          {allCategories.map((cat, idx) => (
            <button
              type="button"
              class={`filter-btn ${idx === 0 ? 'active' : ''}`}
              data-category={cat}
            >
              {cat}
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- ARTICLES GRID -->
    <section class="articles-section">
      <div class="wrap">
        <div class="articles-grid" id="articles-grid">
          {blogArticles.map((post) => (
            <article class="article-card" data-category={post.category}>
              <div class="card-top">
                <div class="card-meta">
                  <span class="card-cat">{post.category}</span>
                  <span class="card-time">⏱️ {post.readTime}</span>
                </div>
                <h2 class="card-title">
                  <a href={`/blog/${post.slug}`}>{post.title}</a>
                </h2>
                <p class="card-summary">{post.summary}</p>
                <div class="card-tags">
                  {post.keywords.map(kw => (
                    <span class="tag-item">#{kw}</span>
                  ))}
                </div>
              </div>
              <div class="card-footer">
                <span class="card-date">Publié le {post.date}</span>
                <a href={`/blog/${post.slug}`} class="card-link">
                  Lire l'article &rarr;
                </a>
              </div>
            </article>
          ))}
        </div>

        <!-- CTA CONVERSION BANNER -->
        <div class="cta-box">
          <h2>Vous avez un projet d'application mobile ou d'IA embarquée ?</h2>
          <p>
            Bénéficiez d'une estimation budgétaire détaillée, d'une recommandation de stack technique (React Native ou Flutter) et d'un audit architectural en moins de 48 heures.
          </p>
          <div class="cta-buttons">
            <a href="https://wa.me/212710911949?text=Bonjour,%20j'ai%20un%20projet%20d'application%20mobile%20et%20je%20souhaite%20un%20audit/devis" target="_blank" rel="noopener" class="btn btn-whatsapp">
              💬 Discuter sur WhatsApp (+212 710 911 949)
            </a>
            <a href="/nos-produits" class="btn btn-light">
              📱 Voir nos 19 Applications Déployées
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="wrap footer-inner">
      <div class="footer-links">
        <a href="/">Accueil</a>
        <a href="/nos-produits">Catalogue Applications</a>
        <a href="/blog">Blog & Guides</a>
        <a href="/aide">Centre d'Aide & Support</a>
        <a href="/partenaires">Espace Affiliation</a>
        <a href="/terms">Conditions Générales</a>
        <a href="/privacy">Confidentialité</a>
      </div>
      <p>&copy; {new Date().getFullYear()} AGH Data Agency Holding SA. Tous droits réservés. Entreprise 100% remote spécialisée en développement mobile et intelligence artificielle.</p>
    </div>
  </footer>

  <!-- CLIENT FILTER SCRIPT -->
  <script is:inline>
    const filterButtons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.article-card');

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const selectedCat = btn.getAttribute('data-category');

        cards.forEach(card => {
          const cardCat = card.getAttribute('data-category');
          if (selectedCat === 'Tous' || cardCat === selectedCat) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
</body>
</html>
