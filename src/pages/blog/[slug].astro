---
import { blogArticles, type BlogPost } from '../../data/blogArticles';

export function getStaticPaths() {
  return blogArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: BlogPost;
}

const { article } = Astro.props;
const canonicalUrl = `https://datagenere.com/blog/${article.slug}`;

// 3 related articles
const relatedArticles = blogArticles
  .filter(a => a.slug !== article.slug)
  .slice(0, 3);

const jsonLdArticle = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": article.title,
  "description": article.metaDescription,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalUrl
  },
  "datePublished": article.date,
  "dateModified": article.date,
  "author": {
    "@type": "Organization",
    "name": "Équipe Technique AGH Data Agency",
    "url": "https://datagenere.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "AGH Data Agency Holding SA",
    "logo": {
      "@type": "ImageObject",
      "url": "https://datagenere.com/logo.jpg"
    }
  },
  "keywords": article.keywords.join(", ")
};

const breadcrumbsJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Accueil",
      "item": "https://datagenere.com/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "Blog",
      "item": "https://datagenere.com/blog"
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": article.title,
      "item": canonicalUrl
    }
  ]
};
---

<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{article.title} — AGH Data Agency</title>
  <meta name="description" content={article.metaDescription} />
  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/jpeg" href="/logo.jpg" />

  <!-- Open Graph -->
  <meta property="og:type" content="article" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={`${article.title} | AGH Data Agency`} />
  <meta property="og:description" content={article.metaDescription} />
  <meta property="og:image" content="https://datagenere.com/logo.jpg" />
  <meta property="article:published_time" content={article.date} />
  <meta property="article:section" content={article.category} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={article.title} />
  <meta name="twitter:description" content={article.metaDescription} />
  <meta name="twitter:image" content="https://datagenere.com/logo.jpg" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Fira+Code:wght@400;500&display=swap" rel="stylesheet">

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLdArticle)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbsJsonLd)} />

  <!-- Google Analytics 4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-V51T1RG6YX" is:inline></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-V51T1RG6YX');
  </script>

  <style>
    :root {
      --primary: #4F46E5;
      --primary-hover: #4338CA;
      --primary-light: #EEF2FF;
      --dark: #0B132B;
      --text: #1E293B;
      --muted: #64748B;
      --border: #E2E8F0;
      --bg-page: #F8FAFC;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background: var(--bg-page);
      color: var(--text);
      line-height: 1.7;
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; text-decoration: none; }
    .wrap {
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 24px;
    }

    /* HEADER */
    .header {
      background: #FFFFFF;
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .header-inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
      height: 74px;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .brand-img {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      object-fit: cover;
    }
    .brand-title {
      font-weight: 800;
      font-size: 1.15rem;
      letter-spacing: -0.01em;
      color: var(--dark);
      display: block;
      line-height: 1.2;
    }
    .brand-sub {
      font-size: 0.76rem;
      color: var(--muted);
      font-weight: 500;
    }
    .nav {
      display: flex;
      align-items: center;
      gap: 20px;
    }
    .nav-link {
      font-size: 0.92rem;
      font-weight: 600;
      color: #334155;
      transition: color 0.2s;
    }
    .nav-link:hover, .nav-link.active {
      color: var(--primary);
    }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-weight: 700;
      padding: 10px 20px;
      border-radius: 9999px;
      transition: all 0.2s;
      cursor: pointer;
      font-size: 0.9rem;
    }
    .btn-whatsapp {
      background: #16A34A;
      color: #FFFFFF;
    }
    .btn-whatsapp:hover {
      background: #15803D;
    }

    /* BREADCRUMB */
    .breadcrumb-bar {
      padding: 18px 0;
      background: #FFFFFF;
      border-bottom: 1px solid var(--border);
      font-size: 0.86rem;
      color: var(--muted);
    }
    .breadcrumb-bar a {
      color: #475569;
      font-weight: 500;
      transition: color 0.2s;
    }
    .breadcrumb-bar a:hover {
      color: var(--primary);
    }
    .sep { margin: 0 8px; color: #CBD5E1; }
    .current { color: var(--dark); font-weight: 600; }

    /* ARTICLE HEADER */
    .article-hero {
      background: linear-gradient(180deg, #FFFFFF 0%, #F1F5F9 100%);
      padding: 50px 0 40px;
      border-bottom: 1px solid var(--border);
    }
    .article-hero-inner {
      max-width: 820px;
      margin: 0 auto;
    }
    .post-meta-top {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 18px;
    }
    .post-cat {
      background: var(--primary);
      color: #FFFFFF;
      font-size: 0.78rem;
      font-weight: 700;
      padding: 4px 12px;
      border-radius: 8px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .post-time, .post-date {
      font-size: 0.85rem;
      color: var(--muted);
      font-weight: 500;
    }
    .post-h1 {
      font-family: 'Outfit', sans-serif;
      font-size: 2.5rem;
      font-weight: 800;
      line-height: 1.22;
      color: var(--dark);
      margin-bottom: 22px;
    }
    .lead-box {
      background: #FFFFFF;
      border-left: 4px solid var(--primary);
      border-radius: 0 12px 12px 0;
      padding: 20px 24px;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
      font-size: 1.1rem;
      color: #334155;
      line-height: 1.65;
    }
    .author-bar {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: 24px;
      font-size: 0.88rem;
      color: var(--muted);
    }
    .author-avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      object-fit: cover;
    }

    /* MAIN CONTENT */
    .content-wrap {
      padding: 50px 0 80px;
    }
    .article-container {
      max-width: 820px;
      margin: 0 auto;
    }
    .article-body {
      background: #FFFFFF;
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 48px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
      font-size: 1.05rem;
      color: #334155;
    }
    .article-body h2 {
      font-family: 'Outfit', sans-serif;
      font-size: 1.75rem;
      font-weight: 700;
      color: var(--dark);
      margin: 36px 0 16px;
      padding-bottom: 8px;
      border-bottom: 2px solid #F1F5F9;
    }
    .article-body h3 {
      font-family: 'Outfit', sans-serif;
      font-size: 1.3rem;
      font-weight: 600;
      color: #1E293B;
      margin: 26px 0 12px;
    }
    .article-body p {
      margin-bottom: 20px;
      line-height: 1.75;
    }
    .article-body ul, .article-body ol {
      margin: 0 0 24px 24px;
      line-height: 1.8;
    }
    .article-body li {
      margin-bottom: 8px;
    }
    .article-body strong {
      color: var(--dark);
    }
    .article-body a {
      color: var(--primary);
      text-decoration: underline;
      text-underline-offset: 3px;
      font-weight: 600;
    }
    .article-body a:hover {
      color: var(--primary-hover);
    }

    /* CALLOUT */
    .article-callout {
      background: #EEF2FF;
      border: 1px solid #C7D2FE;
      border-left: 5px solid var(--primary);
      border-radius: 10px;
      padding: 22px;
      margin: 30px 0;
    }
    .article-callout h4 {
      font-size: 1.1rem;
      color: #1E1B4B;
      margin-bottom: 8px;
      font-weight: 700;
    }
    .article-callout p {
      margin-bottom: 0;
      color: #312E81;
      font-size: 0.98rem;
    }

    /* TABLES */
    .table-container {
      overflow-x: auto;
      margin: 28px 0;
      border-radius: 12px;
      border: 1px solid var(--border);
    }
    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
      font-size: 0.95rem;
    }
    thead {
      background: #0B132B;
      color: #FFFFFF;
    }
    th, td {
      padding: 14px 18px;
      border-bottom: 1px solid var(--border);
    }
    tbody tr:nth-child(even) {
      background: #F8FAFC;
    }
    tbody tr:hover {
      background: #EEF2FF;
    }

    /* CODE & PRE */
    pre {
      background: #0B132B;
      color: #E2E8F0;
      padding: 20px;
      border-radius: 10px;
      overflow-x: auto;
      margin: 24px 0;
      font-family: 'Fira Code', monospace;
      font-size: 0.9rem;
    }
    code {
      font-family: 'Fira Code', monospace;
      background: #F1F5F9;
      color: #D946EF;
      padding: 2px 6px;
      border-radius: 4px;
      font-size: 0.9em;
    }
    pre code {
      background: transparent;
      color: inherit;
      padding: 0;
    }

    /* KEYWORDS FOOTER */
    .post-keywords {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 36px;
      padding-top: 24px;
      border-top: 1px solid var(--border);
    }
    .kw-pill {
      background: #F1F5F9;
      color: #475569;
      padding: 6px 14px;
      border-radius: 9999px;
      font-size: 0.8rem;
      font-weight: 600;
    }

    /* AUTHOR BIO BOX */
    .author-bio {
      background: #FFFFFF;
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 30px;
      margin-top: 40px;
      display: flex;
      align-items: center;
      gap: 22px;
    }
    .bio-img {
      width: 72px;
      height: 72px;
      border-radius: 14px;
      object-fit: cover;
      flex-shrink: 0;
    }
    .bio-info h3 {
      font-size: 1.15rem;
      margin-bottom: 6px;
    }
    .bio-info p {
      font-size: 0.9rem;
      color: #64748B;
      margin-bottom: 0;
    }

    /* ARTICLE CTA CONVERSION */
    .article-cta {
      background: linear-gradient(135deg, #0B132B 0%, #1E293B 100%);
      color: #FFFFFF;
      border-radius: 16px;
      padding: 40px;
      margin-top: 40px;
      text-align: center;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .article-cta h3 {
      color: #FFFFFF;
      font-size: 1.8rem;
      margin-bottom: 12px;
    }
    .article-cta p {
      color: #94A3B8;
      max-width: 620px;
      margin: 0 auto 26px;
      font-size: 1.05rem;
    }
    .cta-flex {
      display: flex;
      justify-content: center;
      gap: 16px;
      flex-wrap: wrap;
    }
    .btn-light {
      background: #FFFFFF;
      color: #0B132B;
      font-weight: 700;
    }
    .btn-light:hover {
      background: #F1F5F9;
      transform: translateY(-2px);
    }

    /* RELATED ARTICLES */
    .related-section {
      margin-top: 60px;
    }
    .related-title {
      font-size: 1.5rem;
      margin-bottom: 24px;
      font-family: 'Outfit', sans-serif;
    }
    .related-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 20px;
    }
    .related-card {
      background: #FFFFFF;
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 20px;
      transition: all 0.2s;
    }
    .related-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 24px rgba(0,0,0,0.06);
      border-color: #CBD5E1;
    }
    .related-card h4 {
      font-size: 1rem;
      margin-bottom: 8px;
      line-height: 1.4;
    }
    .related-card p {
      font-size: 0.85rem;
      color: var(--muted);
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    /* FOOTER */
    .footer {
      background: #0B132B;
      color: #94A3B8;
      padding: 50px 0 30px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      font-size: 0.88rem;
    }
    .footer-inner {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 20px;
    }
    .footer-links {
      display: flex;
      gap: 24px;
      flex-wrap: wrap;
      justify-content: center;
    }
    .footer-links a:hover {
      color: #FFFFFF;
    }

    @media (max-width: 768px) {
      .post-h1 { font-size: 1.9rem; }
      .article-body { padding: 24px; }
      .nav-link { display: none; }
      .author-bio { flex-direction: column; text-align: center; }
    }
  </style>
</head>

<body>
  <!-- HEADER -->
  <header class="header">
    <div class="wrap header-inner">
      <a href="/" class="brand">
        <img src="/logo.jpg" alt="Logo AGH Data Agency" class="brand-img" />
        <div class="brand-text">
          <span class="brand-title">AGH DATA AGENCY</span>
          <span class="brand-sub">Blog Technique & Guides Mobiles</span>
        </div>
      </a>
      <nav class="nav">
        <a href="/" class="nav-link">Accueil</a>
        <a href="/nos-produits" class="nav-link">Catalogue Apps</a>
        <a href="/blog" class="nav-link active">Blog Tech</a>
        <a href="/aide" class="nav-link">Centre d'Aide</a>
        <a href="/partenaires" class="nav-link">Affiliés</a>
        <a href="https://wa.me/212710911949" target="_blank" rel="noopener" class="btn btn-whatsapp">
          WhatsApp Pro
        </a>
      </nav>
    </div>
  </header>

  <!-- BREADCRUMB -->
  <div class="breadcrumb-bar">
    <div class="wrap">
      <a href="/">Accueil</a>
      <span class="sep">/</span>
      <a href="/blog">Blog</a>
      <span class="sep">/</span>
      <span class="current">{article.title}</span>
    </div>
  </div>

  <main>
    <!-- HERO ARTICLE -->
    <header class="article-hero">
      <div class="wrap article-hero-inner">
        <div class="post-meta-top">
          <span class="post-cat">{article.category}</span>
          <span class="post-time">⏱️ {article.readTime} de lecture</span>
          <span class="post-date">📅 Mis à jour le {article.date}</span>
        </div>
        <h1 class="post-h1">{article.title}</h1>
        <div class="lead-box">
          {article.summary}
        </div>
        <div class="author-bar">
          <img src="/logo.jpg" alt="AGH Data Agency" class="author-avatar" />
          <div>
            <strong>Équipe Ingénierie AGH Data Agency</strong> — Pôle Architecture Mobile & IA
          </div>
        </div>
      </div>
    </header>

    <!-- CONTENT BODY -->
    <div class="content-wrap">
      <div class="wrap article-container">
        <article class="article-body">
          <Fragment set:html={article.contentHtml} />

          <div class="post-keywords">
            {article.keywords.map(kw => (
              <span class="kw-pill">#{kw}</span>
            ))}
          </div>
        </article>

        <!-- AUTHOR BIO -->
        <div class="author-bio">
          <img src="/logo.jpg" alt="Logo AGH Data Agency" class="bio-img" />
          <div class="bio-info">
            <h3>À propos d'AGH Data Agency Holding SA</h3>
            <p>
              Agence technologique 100% remote spécialisée dans la conception d'architectures mobiles robustes, d'intelligence artificielle embarquée (Edge AI) et de systèmes de haute sécurité. Créateurs de plus de 19 applications autonomes déployées à l'international.
            </p>
          </div>
        </div>

        <!-- CONVERSION CTA -->
        <div class="article-cta">
          <h3>Un projet d'application mobile ou besoin de renfort technique ?</h3>
          <p>
            Échangez directement avec nos architectes logiciels. Nous analysons vos spécifications, optimisons votre budget et vous livrons un plan de développement clair en 48 heures.
          </p>
          <div class="cta-flex">
            <a href="https://wa.me/212710911949?text=Bonjour,%20j'ai%20lu%20votre%20article%20sur%20datagenere.com%20et%20je%20souhaite%20un%20devis" target="_blank" rel="noopener" class="btn btn-whatsapp">
              💬 Échanger sur WhatsApp (+212 710 911 949)
            </a>
            <a href="/nos-produits" class="btn btn-light">
              📱 Découvrir notre Catalogue d'Apps
            </a>
          </div>
        </div>

        <!-- RELATED ARTICLES -->
        <section class="related-section">
          <h3 class="related-title">Articles recommandés</h3>
          <div class="related-grid">
            {relatedArticles.map((rel) => (
              <a href={`/blog/${rel.slug}`} class="related-card">
                <span style="font-size: 0.75rem; color: var(--primary); font-weight: 700; text-transform: uppercase;">{rel.category}</span>
                <h4>{rel.title}</h4>
                <p>{rel.summary}</p>
              </a>
            ))}
          </div>
        </section>
      </div>
    </div>
  </main>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="wrap footer-inner">
      <div class="footer-links">
        <a href="/">Accueil</a>
        <a href="/nos-produits">Catalogue Applications</a>
        <a href="/blog">Blog & Guides</a>
        <a href="/aide">Centre d'Aide & Support</a>
        <a href="/partenaires">Espace Affiliation</a>
        <a href="/terms">Conditions Générales</a>
        <a href="/privacy">Confidentialité</a>
      </div>
      <p>&copy; {new Date().getFullYear()} AGH Data Agency Holding SA. Tous droits réservés. Entreprise 100% remote spécialisée en développement mobile et intelligence artificielle.</p>
    </div>
  </footer>
</body>
</html>
