---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { products, type ProductConfig } from '../../data/products';

export function getStaticPaths() {
  const paths = [];
  for (const product of Object.values(products)) {
    paths.push({
      params: { product: product.slug },
      props: { product },
    });

    if (product.aliases) {
      for (const alias of product.aliases) {
        paths.push({
          params: { product: alias },
          props: { product },
        });
      }
    }
  }
  return paths;
}

interface Props {
  product: ProductConfig;
}

const { product } = Astro.props;
const { thankYou } = product;
---

<Layout
  title={`Merci pour votre achat — ${product.name}`}
  description={`Téléchargez votre application ${product.name} et suivez le guide d'installation pour activer votre licence.`}
  theme={product.theme}
>
  <!-- DÉCLENCHEMENT DE L'ÉVÉNEMENT D'ACHAT (PURCHASE) SUR LA THANK YOU PAGE UNIQUEMENT -->
  <script is:inline define:vars={{ productName: product.name }}>
    if (typeof window !== 'undefined') {
      const urlParams = new URLSearchParams(window.location.search);
      const orderId = urlParams.get('order_number') || urlParams.get('sale_id') || 'GUMROAD_' + Date.now();

      // Meta Pixel Purchase Event
      if (typeof window.fbq === 'function') {
        window.fbq('track', 'Purchase', {
          content_name: productName,
          currency: 'EUR',
          value: 29.99,
        });
      }

      // Google Analytics 4 Purchase Event
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'purchase', {
          transaction_id: orderId,
          value: 29.99,
          currency: 'EUR',
          items: [{ item_name: productName }],
        });
      }
    }
  </script>

  <!-- HEADER SIMPLE -->
  <header class="merci-header">
    <div class="wrap header-wrap">
      <a class="brand" href={`/${product.slug}`}>
        <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M24 6c-6 0-9 5-9 10 0 3 1.3 5 3 6.5-2 1-3 3-3 5.5v4h18v-4c0-2.5-1-4.5-3-5.5 1.7-1.5 3-3.5 3-6.5 0-5-3-10-9-10Z" fill="currentColor"/>
          <rect x="15" y="34" width="18" height="4" rx="2" fill="currentColor"/>
        </svg>
        <span>{product.name}</span>
      </a>
      <a class="back-link" href={`/${product.slug}`}>← Retour à la présentation</a>
    </div>
  </header>

  <main class="merci-main">
    <div class="wrap">

      <!-- CONFIRMATION BANNER -->
      <div class="status-badge-wrap">
        <span class="status-badge">
          <svg viewBox="0 0 20 20" fill="currentColor" class="badge-icon" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
          {thankYou.badgeText}
        </span>
      </div>

      <h1 class="merci-title">{thankYou.title}</h1>
      <p class="merci-subtitle">{thankYou.subtitle}</p>

      <!-- CLIENT EMAIL NOTIFICATION (SI PARAMÈTRE ?email= FOURNI PAR GUMROAD) -->
      <div id="customer-email-box" class="customer-email-box" style="display:none;">
        Un reçu détaillé et votre confirmation ont été envoyés à : <strong id="customer-email-text"></strong>
      </div>

      <!-- CARTE DE TÉLÉCHARGEMENT PRINCIPALE -->
      <section class="download-card">
        <div class="download-head">
          <div class="app-icon-badge">📱</div>
          <div>
            <h2>Téléchargez votre application Android</h2>
            <p class="download-meta">
              Fichier : <strong>{thankYou.apkFilename}</strong> · Version : {thankYou.apkVersion} · Taille : {thankYou.apkSize}
            </p>
          </div>
        </div>

        <div class="download-actions">
          <a class="btn btn-primary btn-download" href={thankYou.apkDownloadUrl} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="btn-icon" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Télécharger l'APK directement (.apk)
          </a>

          {thankYou.googlePlayUrl && (
            <a class="btn btn-ghost" href={thankYou.googlePlayUrl} target="_blank" rel="noopener noreferrer">
              Voir sur Google Play
            </a>
          )}
        </div>

        <!-- ENCADRÉ CLÉ DE LICENCE DYNAMIQUE -->
        <div id="license-dynamic-container" class="license-box">
          <div class="license-icon">🔑</div>
          <div class="license-content">
            <strong>Activation de votre licence</strong>
            
            <!-- Affiché si license_key est présent dans l'URL Gumroad (?license_key=...) -->
            <div id="license-key-found" style="display:none;">
              <p>Voici votre clé de licence personnelle à copier dans l'application :</p>
              <div class="key-display-row">
                <code id="license-key-code" class="license-code"></code>
                <button id="copy-license-btn" class="btn-copy" type="button">
                  <span id="copy-btn-text">Copier la clé</span>
                </button>
              </div>
            </div>

            <!-- Affiché par défaut si aucun paramètre d'URL n'est transmis -->
            <div id="license-key-fallback">
              <p>
                Votre reçu d'achat ainsi que votre <strong>clé de licence personnelle</strong> vous ont été envoyés par email par Gumroad.
                Copiez cette clé pour débloquer votre accès lors du premier lancement de l'application.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ÉTAPES D'INSTALLATION -->
      <section class="guide-section">
        <span class="eyebrow guide-eyebrow">Prise en main rapide</span>
        <h2>Comment installer votre application en 3 minutes</h2>

        <div class="guide-steps">
          {thankYou.installationSteps.map((step) => (
            <div class="guide-step-card">
              <div class="step-num">{step.number}</div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- FAQ & SUPPORT -->
      <section class="support-grid">
        <div class="faq-box">
          <h3>Questions fréquentes</h3>
          <div class="faq-list">
            {thankYou.faq.map((item) => (
              <details class="faq-item">
                <summary><strong>{item.question}</strong></summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </div>

        <div class="help-box">
          <div class="help-icon">💬</div>
          <h3>Besoin d'aide ?</h3>
          <p>Notre équipe technique est à votre disposition pour vous accompagner dans l'installation ou la configuration de votre licence.</p>
          <div class="help-links">
            <a class="btn btn-primary" href={`mailto:${thankYou.supportEmail}`}>
              Contacter le support par email
            </a>
            {thankYou.supportWhatsapp && (
              <a class="btn btn-ghost btn-whatsapp" href={`https://wa.me/${thankYou.supportWhatsapp.replace(/[^0-9]/g, '')}`} target="_blank" rel="noopener noreferrer">
                Assistance WhatsApp ({thankYou.supportWhatsapp})
              </a>
            )}
          </div>
          <div class="guarantee-tag">
            🛡️ <strong>Garantie AGH Data Agency Holding</strong> : 30 jours satisfait ou remboursé sans condition.
          </div>
        </div>
      </section>

    </div>
  </main>

  <Footer productName={product.name} />

  <!-- SCRIPT CLIENT POUR LE TRAITEMENT DES PARAMÈTRES GUMROAD ET LE COPIER-COLLER -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const params = new URLSearchParams(window.location.search);
      const email = params.get('email');
      const licenseKey = params.get('license_key');

      // 1. Affichage de l'email si présent
      if (email) {
        const emailBox = document.getElementById('customer-email-box');
        const emailText = document.getElementById('customer-email-text');
        if (emailBox && emailText) {
          emailText.textContent = email;
          emailBox.style.display = 'block';
        }
      }

      // 2. Affichage dynamique de la clé de licence si transmise par Gumroad
      if (licenseKey) {
        const keyFound = document.getElementById('license-key-found');
        const keyFallback = document.getElementById('license-key-fallback');
        const keyCode = document.getElementById('license-key-code');
        const copyBtn = document.getElementById('copy-license-btn');
        const copyBtnText = document.getElementById('copy-btn-text');

        if (keyFound && keyFallback && keyCode) {
          keyCode.textContent = licenseKey;
          keyFound.style.display = 'block';
          keyFallback.style.display = 'none';

          if (copyBtn && copyBtnText) {
            copyBtn.addEventListener('click', async () => {
              try {
                await navigator.clipboard.writeText(licenseKey);
                copyBtnText.textContent = '✓ Clé copiée !';
                copyBtn.classList.add('copied');
                setTimeout(() => {
                  copyBtnText.textContent = 'Copier la clé';
                  copyBtn.classList.remove('copied');
                }, 2500);
              } catch (err) {
                // Fallback de sélection si permissions bloquées
                const range = document.createRange();
                range.selectNodeContents(keyCode);
                const selection = window.getSelection();
                selection.removeAllRanges();
                selection.addRange(range);
                copyBtnText.textContent = 'Sélectionnée !';
              }
            });
          }
        }
      }
    });
  </script>
</Layout>

<style>
  .merci-header {
    background: rgba(253, 238, 225, .9);
    border-bottom: 1px solid var(--line);
    padding: 18px 0;
  }
  .header-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: "Fraunces", serif;
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--charcoal);
    text-decoration: none;
  }
  .brand svg {
    width: 28px;
    height: 28px;
    color: var(--flame);
  }
  .back-link {
    font-size: 0.9rem;
    color: var(--ink);
    text-decoration: none;
    font-weight: 500;
  }
  .back-link:hover {
    color: var(--flame);
  }

  .merci-main {
    padding: 60px 0 90px;
  }
  .status-badge-wrap {
    text-align: center;
    margin-bottom: 18px;
  }
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #EAF8EF;
    color: #1F9D55;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    font-weight: 700;
    padding: 8px 18px;
    border-radius: 100px;
    border: 1px solid #B8E8C7;
  }
  .badge-icon {
    width: 18px;
    height: 18px;
  }
  .merci-title {
    text-align: center;
    font-size: clamp(2rem, 3.8vw, 2.7rem);
    color: var(--charcoal);
    margin-bottom: 12px;
  }
  .merci-subtitle {
    text-align: center;
    max-width: 580px;
    margin: 0 auto 28px;
    color: #5A4632;
    font-size: 1.08rem;
    line-height: 1.6;
  }

  .customer-email-box {
    max-width: 600px;
    margin: 0 auto 34px;
    text-align: center;
    background: #FFF;
    border: 1px solid var(--line);
    border-radius: 100px;
    padding: 10px 22px;
    font-size: 0.92rem;
    color: #5A4632;
    box-shadow: 0 4px 14px rgba(43, 29, 16, 0.04);
  }

  /* DOWNLOAD CARD */
  .download-card {
    max-width: 760px;
    margin: 0 auto 60px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 24px;
    padding: 38px;
    box-shadow: 0 12px 36px rgba(43, 29, 16, .08);
  }
  .download-head {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 26px;
  }
  .app-icon-badge {
    width: 60px;
    height: 60px;
    border-radius: 16px;
    background: var(--peach);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.8rem;
    flex-shrink: 0;
  }
  .download-head h2 {
    font-size: 1.45rem;
    margin: 0 0 6px;
  }
  .download-meta {
    color: #5A4632;
    font-size: 0.92rem;
    margin: 0;
  }
  .download-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 26px;
  }
  .btn-download {
    font-size: 1.05rem;
    padding: 16px 30px;
  }
  .btn-icon {
    width: 20px;
    height: 20px;
  }

  .license-box {
    display: flex;
    gap: 16px;
    background: #FFF8F1;
    border: 1.5px dashed var(--flame);
    border-radius: 16px;
    padding: 20px;
    font-size: 0.92rem;
    color: #4A3A2A;
  }
  .license-icon {
    font-size: 1.6rem;
    line-height: 1;
  }
  .license-content {
    flex: 1;
  }
  .license-content strong {
    font-size: 1rem;
    color: var(--charcoal);
  }
  .license-content p {
    margin: 6px 0 10px;
    line-height: 1.5;
  }

  .key-display-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 10px;
  }
  .license-code {
    font-family: "JetBrains Mono", monospace;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--flame-dark);
    background: #FFF;
    border: 1px solid var(--line);
    padding: 8px 16px;
    border-radius: 8px;
    letter-spacing: 0.08em;
  }
  .btn-copy {
    background: var(--charcoal);
    color: #FFF;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .btn-copy:hover {
    background: var(--flame);
  }
  .btn-copy.copied {
    background: #1F9D55;
  }

  /* GUIDE STEPS */
  .guide-section {
    max-width: 900px;
    margin: 0 auto 70px;
    text-align: center;
  }
  .guide-eyebrow {
    display: block;
    margin-bottom: 8px;
  }
  .guide-section h2 {
    font-size: 1.8rem;
    margin-bottom: 34px;
  }
  .guide-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    text-align: left;
  }
  .guide-step-card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 26px;
    box-shadow: 0 4px 14px rgba(43, 29, 16, .04);
  }
  .step-num {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--flame);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.1rem;
    margin-bottom: 16px;
  }
  .guide-step-card h3 {
    font-size: 1.12rem;
    margin-bottom: 8px;
  }
  .guide-step-card p {
    color: #5A4632;
    font-size: 0.92rem;
    line-height: 1.55;
    margin: 0;
  }

  /* SUPPORT & FAQ */
  .support-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 28px;
    max-width: 900px;
    margin: 0 auto;
  }
  .faq-box, .help-box {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 30px;
  }
  .faq-box h3, .help-box h3 {
    font-size: 1.25rem;
    margin-top: 0;
    margin-bottom: 20px;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .faq-item {
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 14px 16px;
    cursor: pointer;
    background: #FFFDF9;
  }
  .faq-item summary {
    font-size: 0.95rem;
    color: var(--charcoal);
  }
  .faq-item p {
    margin: 10px 0 0;
    color: #5A4632;
    font-size: 0.9rem;
    line-height: 1.55;
  }
  .help-icon {
    font-size: 2rem;
    margin-bottom: 10px;
  }
  .help-box p {
    color: #5A4632;
    font-size: 0.93rem;
    line-height: 1.55;
    margin-bottom: 22px;
  }
  .help-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 22px;
  }
  .btn-whatsapp {
    border-color: #25D366;
    color: #128C7E;
  }
  .btn-whatsapp:hover {
    background: #25D366;
    color: #FFF;
  }
  .guarantee-tag {
    background: var(--peach);
    border-radius: 10px;
    padding: 12px 14px;
    font-size: 0.82rem;
    color: var(--charcoal);
    line-height: 1.45;
  }

  @media (max-width: 820px) {
    .guide-steps {
      grid-template-columns: 1fr;
    }
    .support-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
