---
import { products, type ProductConfig } from '../../data/products';
import { getMerciTheme } from '../../data/merciThemeMap';

export function getStaticPaths() {
  const paths = [];
  for (const product of Object.values(products)) {
    paths.push({
      params: { product: product.slug },
      props: { product, currentSlug: product.slug },
    });

    if (product.aliases) {
      for (const alias of product.aliases) {
        paths.push({
          params: { product: alias },
          props: { product, currentSlug: alias },
        });
      }
    }
  }
  return paths;
}

interface Props {
  product: ProductConfig;
  currentSlug: string;
}

const { product, currentSlug } = Astro.props;
const { thankYou } = product;
const theme = getMerciTheme(currentSlug || product.slug);
---

<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{`Merci pour votre achat — ${product.name}`}</title>
  <meta name="description" content={`Téléchargez votre application ${product.name} et suivez le guide d'installation pour activer votre licence.`} />
  <link rel="canonical" href={Astro.url.href} />

  <!-- Google Fonts Preconnect & App-Specific Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href={theme.fontUrl} rel="stylesheet" />

  <!-- App Icon / Favicon -->
  <link rel="icon" href={theme.cardIconUrl} />

  <!-- GOOGLE ANALYTICS 4 (G-V51T1RG6YX) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-V51T1RG6YX" is:inline></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-V51T1RG6YX');
  </script>

  <!-- META PIXEL (923346630113614) -->
  <script is:inline>
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '923346630113614');
    fbq('track', 'PageView');
  </script>
  <noscript>
    <img height="1" width="1" style="display:none"
         src="https://www.facebook.com/tr?id=923346630113614&ev=PageView&noscript=1" alt="" />
  </noscript>

  <!-- DÉCLENCHEMENT DE L'ÉVÉNEMENT D'ACHAT (PURCHASE) SUR LA THANK YOU PAGE UNIQUEMENT -->
  <script is:inline define:vars={{ productName: product.name }}>
    if (typeof window !== 'undefined') {
      const urlParams = new URLSearchParams(window.location.search);
      const orderId = urlParams.get('order_number') || urlParams.get('sale_id') || urlParams.get('ctransreceipt') || 'ORDER_' + Date.now();

      // Meta Pixel Purchase Event
      if (typeof window.fbq === 'function') {
        window.fbq('track', 'Purchase', {
          content_name: productName,
          currency: 'EUR',
          value: 29.99,
        });
      }

      // Google Analytics 4 Purchase Event
      if (typeof window.gtag === 'function') {
        window.gtag('event', 'purchase', {
          transaction_id: orderId,
          value: 29.99,
          currency: 'EUR',
          items: [{ item_name: productName }],
        });
      }
    }
  </script>
</head>
<body>

  <!-- HEADER HARMONISÉ IDENTIQUE AU SITE DE L'APPLICATION -->
  <header class={`site-header header-${theme.headerType}`}>
    <div class="wrap header-inner">
      <a class="brand" href={`/${product.slug}`} title={`Retour à la présentation de ${product.name}`}>
        {theme.brandType === 'img' ? (
          <img src={theme.brandImgSrc} alt={product.name} class={theme.brandImgClass || 'brand-mark'} />
        ) : (
          <Fragment set:html={theme.brandSvgHtml} />
        )}
        <Fragment set:html={theme.brandTitleHtml} />
      </a>
      <a class="back-link" href={`/${product.slug}`}>
        <span class="back-arrow">←</span>
        <span>Retour à l'application</span>
      </a>
    </div>
  </header>

  <main class="merci-main">
    <div class="wrap">

      <!-- CONFIRMATION STATUS BADGE -->
      <div class="status-badge-wrap">
        <span class="status-badge">
          <svg viewBox="0 0 20 20" fill="currentColor" class="badge-icon" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
          {thankYou.badgeText}
        </span>
      </div>

      <h1 class="merci-title">{thankYou.title}</h1>
      <p class="merci-subtitle">{thankYou.subtitle}</p>

      <!-- NOTIFICATION EMAIL CLIENT (SI TRANSMIS DANS L'URL ?email=... OU ?ccustemail=...) -->
      <div id="customer-email-box" class="customer-email-box" style="display:none;">
        Un reçu détaillé et votre clé d'accès ont été expédiés à : <strong id="customer-email-text"></strong>
      </div>

      <!-- CARTE DE TÉLÉCHARGEMENT PRINCIPALE -->
      <section class="download-card">
        <div class="download-head">
          <div class="app-icon-wrapper">
            <img src={theme.cardIconUrl} alt={product.name} class="download-card-icon" />
          </div>
          <div class="download-info">
            <h2>Téléchargez votre application Android</h2>
            <p class="download-meta">
              Fichier : <strong>{thankYou.apkFilename}</strong> · Version : {thankYou.apkVersion} · Taille : {thankYou.apkSize}
            </p>
          </div>
        </div>

        <div class="download-actions">
          <a class="btn btn-primary btn-download" href={thankYou.apkDownloadUrl} target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="btn-icon" aria-hidden="true">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            <span>Télécharger l'APK directement (.apk)</span>
          </a>

          {thankYou.googlePlayUrl && (
            <a class="btn btn-ghost" href={thankYou.googlePlayUrl} target="_blank" rel="noopener noreferrer">
              Voir sur Google Play
            </a>
          )}
        </div>

        <!-- ENCADRÉ CLÉ DE LICENCE DYNAMIQUE -->
        <div id="license-dynamic-container" class="license-box">
          <div class="license-icon">🔑</div>
          <div class="license-content">
            <strong>Activation de votre licence</strong>
            
            <!-- Affiché si la clé de licence est présente dans l'URL (?license_key=... ou ?cinfo=...) -->
            <div id="license-key-found" style="display:none;">
              <p>Voici votre clé de licence personnelle à copier dans l'application :</p>
              <div class="key-display-row">
                <code id="license-key-code" class="license-code"></code>
                <button id="copy-license-btn" class="btn-copy" type="button">
                  <span id="copy-btn-text">Copier la clé</span>
                </button>
              </div>
            </div>

            <!-- Affiché par défaut si aucun paramètre d'URL n'est transmis -->
            <div id="license-key-fallback">
              <p>
                Votre reçu d'achat ainsi que votre <strong>clé de licence personnelle</strong> vous ont été envoyés par email suite à votre commande.
                Copiez cette clé pour débloquer votre accès lors du premier lancement de l'application.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ÉTAPES D'INSTALLATION -->
      <section class="guide-section">
        <span class="eyebrow guide-eyebrow">Prise en main rapide</span>
        <h2 class="section-title">Comment installer votre application en 3 minutes</h2>

        <div class="guide-steps">
          {thankYou.installationSteps.map((step) => (
            <div class="guide-step-card">
              <div class="step-num">{step.number}</div>
              <h3>{step.title}</h3>
              <p>{step.description}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- FAQ & ASSISTANCE -->
      <section class="support-grid">
        <div class="faq-box">
          <h3>Questions fréquentes</h3>
          <div class="faq-list">
            {thankYou.faq.map((item) => (
              <details class="faq-item">
                <summary><strong>{item.question}</strong></summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </div>

        <div class="help-box">
          <div class="help-icon">💬</div>
          <h3>Besoin d'aide ?</h3>
          <p>Notre équipe technique est à votre disposition pour vous accompagner dans l'installation ou la configuration de votre licence.</p>
          <div class="help-links">
            <a class="btn btn-primary btn-support" href={`mailto:${thankYou.supportEmail}`}>
              Contacter le support par email
            </a>
            {thankYou.supportWhatsapp && (
              <a class="btn btn-ghost btn-whatsapp" href={`https://wa.me/${thankYou.supportWhatsapp.replace(/[^0-9]/g, '')}`} target="_blank" rel="noopener noreferrer">
                Assistance WhatsApp ({thankYou.supportWhatsapp})
              </a>
            )}
          </div>
          <div class="guarantee-tag">
            🛡️ <strong>Garantie AGH Data Agency Holding</strong> : 30 jours satisfait ou remboursé sans condition.
          </div>
        </div>
      </section>

    </div>
  </main>

  <!-- PIED DE PAGE HARMONISÉ IDENTIQUE AU SITE DE L'APPLICATION -->
  {theme.footerType === 'site-footer' ? (
    <footer class="site-footer">
      <div class="wrap footer-inner">
        {theme.footerBrandHtml && (
          <div class="footer-brand">
            <Fragment set:html={theme.footerBrandHtml} />
          </div>
        )}
        {theme.footerNote && (
          <p class="footer-note">{theme.footerNote}</p>
        )}
        <p class="footer-copy">{theme.footerCopyright}</p>
      </div>
      <div class="footer-official-support">
        <span>Support officiel : <a href="mailto:contact@datagenere.com">contact@datagenere.com</a></span>
        <span class="sep">·</span>
        <span>WhatsApp : <a href="https://wa.me/212710911949" target="_blank" rel="noopener">+212 710-911949</a></span>
      </div>
    </footer>
  ) : (
    <footer class="site-footer simple-footer">
      <div class="wrap">
        <p class="footer-copy">{theme.footerCopyright}</p>
      </div>
      <div class="footer-official-support">
        <span>Support officiel : <a href="mailto:contact@datagenere.com">contact@datagenere.com</a></span>
        <span class="sep">·</span>
        <span>WhatsApp : <a href="https://wa.me/212710911949" target="_blank" rel="noopener">+212 710-911949</a></span>
      </div>
    </footer>
  )}

  <!-- SCRIPT CLIENT EXTRACTION DONNÉES DE COMMANDE & COPIE DE LA CLÉ -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const params = new URLSearchParams(window.location.search);
      const email = params.get('email') || params.get('ccustemail');
      const licenseKey = params.get('license_key') || params.get('cinfo') || params.get('ctransreceipt') || params.get('key');

      // 1. Affichage de l'email si présent
      if (email) {
        const emailBox = document.getElementById('customer-email-box');
        const emailText = document.getElementById('customer-email-text');
        if (emailBox && emailText) {
          emailText.textContent = email;
          emailBox.style.display = 'block';
        }
      }

      // 2. Affichage dynamique de la clé de licence si transmise dans l'URL
      if (licenseKey) {
        const keyFound = document.getElementById('license-key-found');
        const keyFallback = document.getElementById('license-key-fallback');
        const keyCode = document.getElementById('license-key-code');
        const copyBtn = document.getElementById('copy-license-btn');
        const copyBtnText = document.getElementById('copy-btn-text');

        if (keyFound && keyFallback && keyCode) {
          keyCode.textContent = licenseKey;
          keyFound.style.display = 'block';
          keyFallback.style.display = 'none';

          if (copyBtn && copyBtnText) {
            copyBtn.addEventListener('click', async () => {
              try {
                await navigator.clipboard.writeText(licenseKey);
                copyBtnText.textContent = '✓ Clé copiée !';
                copyBtn.classList.add('copied');
                setTimeout(() => {
                  copyBtnText.textContent = 'Copier la clé';
                  copyBtn.classList.remove('copied');
                }, 2500);
              } catch (err) {
                const range = document.createRange();
                range.selectNodeContents(keyCode);
                const selection = window.getSelection();
                selection.removeAllRanges();
                selection.addRange(range);
                copyBtnText.textContent = 'Sélectionnée !';
              }
            });
          }
        }
      }
    });
  </script>

</body>
</html>

<style define:vars={{
  bg: theme.bg,
  text: theme.text,
  headings: theme.headings,
  mutedText: theme.mutedText,
  primaryBg: theme.primaryBg,
  primaryHoverBg: theme.primaryHoverBg,
  primaryText: theme.primaryText,
  primaryShadow: theme.primaryShadow,
  btnRadius: theme.btnRadius,
  ghostBorder: theme.ghostBorder,
  ghostText: theme.ghostText,
  ghostHoverBg: theme.ghostHoverBg,
  ghostHoverText: theme.ghostHoverText,
  line: theme.line,
  cardBg: theme.cardBg,
  cardShadow: theme.cardShadow,
  cardRadius: theme.cardRadius,
  licenseBoxBg: theme.licenseBoxBg,
  licenseBoxBorder: theme.licenseBoxBorder,
  badgeBg: theme.badgeBg,
  badgeText: theme.badgeText,
  badgeBorder: theme.badgeBorder,
  stepNumBg: theme.stepNumBg,
  stepNumText: theme.stepNumText,
  helpBoxBg: theme.helpBoxBg,
  headerBg: theme.headerBg,
  headerText: theme.headerTextColor,
  headerBorder: theme.headerBorderBottom,
  headerLink: theme.headerBackLinkColor,
  headerLinkHover: theme.headerBackLinkHoverColor,
  fontDisplay: theme.fontDisplay,
  fontBody: theme.fontBody,
  fontMono: theme.fontMono,
  footerBg: theme.footerBg,
  footerText: theme.footerTextColor,
  footerBorder: theme.footerBorderTop,
}}>
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--fontBody);
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  img { max-width: 100%; display: block; }
  a { color: inherit; text-decoration: none; }
  .wrap { max-width: 1180px; margin: 0 auto; padding: 0 24px; }

  h1, h2, h3, h4, .section-title {
    font-family: var(--fontDisplay);
    color: var(--headings);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0;
  }

  p {
    margin: 0;
    color: var(--mutedText);
    line-height: 1.65;
  }

  /* HEADER */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--headerBg);
    border-bottom: var(--headerBorder);
    color: var(--headerText);
    backdrop-filter: blur(10px);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 0;
    min-height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--fontDisplay);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--headerText);
    text-decoration: none;
    transition: opacity .15s ease;
  }
  .brand:hover {
    opacity: 0.9;
  }
  .brand-icon-rounded {
    width: 32px;
    height: 32px;
    border-radius: 9px;
    object-fit: contain;
  }
  .brand-mark {
    width: 32px;
    height: 32px;
    object-fit: contain;
  }
  .brand-name {
    font-family: var(--fontDisplay);
    font-weight: 700;
    font-size: 1.08rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--fontDisplay);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--headerLink);
    padding: 8px 16px;
    border-radius: var(--btnRadius);
    border: var(--ghostBorder);
    background: transparent;
    transition: all .15s ease;
    text-decoration: none;
  }
  .back-link:hover {
    background: var(--ghostHoverBg);
    color: var(--ghostHoverText);
    transform: translateY(-1px);
  }
  .back-arrow {
    font-size: 1rem;
    line-height: 1;
  }

  /* BOUTONS */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-family: var(--fontDisplay);
    font-weight: 600;
    font-size: 0.96rem;
    padding: 14px 28px;
    border-radius: var(--btnRadius);
    text-decoration: none;
    transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
    cursor: pointer;
    white-space: nowrap;
    border: none;
  }
  .btn-primary {
    background: var(--primaryBg);
    color: var(--primaryText);
    box-shadow: var(--primaryShadow);
  }
  .btn-primary:hover {
    background: var(--primaryHoverBg);
    transform: translateY(-2px);
    box-shadow: var(--primaryShadow);
  }
  .btn-ghost {
    border: var(--ghostBorder);
    color: var(--ghostText);
    background: transparent;
  }
  .btn-ghost:hover {
    background: var(--ghostHoverBg);
    color: var(--ghostHoverText);
  }

  /* CONTENU PRINCIPAL */
  .merci-main {
    padding: 60px 0 90px;
  }
  .status-badge-wrap {
    text-align: center;
    margin-bottom: 20px;
  }
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--badgeBg);
    color: var(--badgeText);
    border: 1px solid var(--badgeBorder);
    font-family: var(--fontMono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    font-weight: 700;
    padding: 8px 20px;
    border-radius: 999px;
  }
  .badge-icon {
    width: 18px;
    height: 18px;
  }

  .merci-title {
    text-align: center;
    font-size: clamp(2rem, 3.8vw, 2.7rem);
    color: var(--headings);
    margin: 0 0 14px;
    line-height: 1.15;
  }
  .merci-subtitle {
    text-align: center;
    max-width: 580px;
    margin: 0 auto 32px;
    color: var(--mutedText);
    font-size: 1.08rem;
    line-height: 1.6;
  }

  .customer-email-box {
    max-width: 620px;
    margin: 0 auto 34px;
    text-align: center;
    background: var(--cardBg);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 12px 24px;
    font-size: 0.94rem;
    color: var(--mutedText);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.04);
  }
  .customer-email-box strong {
    color: var(--headings);
  }

  /* CARTE DE TÉLÉCHARGEMENT */
  .download-card {
    max-width: 780px;
    margin: 0 auto 60px;
    background: var(--cardBg);
    border: 1px solid var(--line);
    border-radius: var(--cardRadius);
    padding: 38px;
    box-shadow: var(--cardShadow);
  }
  .download-head {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 26px;
  }
  .app-icon-wrapper {
    width: 64px;
    height: 64px;
    border-radius: 16px;
    background: var(--helpBoxBg);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
  }
  .download-card-icon {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .download-info h2 {
    font-size: 1.45rem;
    margin: 0 0 6px;
    color: var(--headings);
  }
  .download-meta {
    font-size: 0.92rem;
    color: var(--mutedText);
  }
  .download-meta strong {
    color: var(--headings);
  }
  .download-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-bottom: 26px;
  }
  .btn-download {
    font-size: 1.05rem;
    padding: 16px 32px;
  }
  .btn-icon {
    width: 20px;
    height: 20px;
  }

  /* LICENCE BOX */
  .license-box {
    display: flex;
    gap: 16px;
    background: var(--licenseBoxBg);
    border: 1.5px dashed var(--licenseBoxBorder);
    border-radius: var(--cardRadius);
    padding: 22px;
    font-size: 0.94rem;
    color: var(--mutedText);
  }
  .license-icon {
    font-size: 1.6rem;
    line-height: 1;
  }
  .license-content {
    flex: 1;
  }
  .license-content strong {
    font-size: 1rem;
    color: var(--headings);
    display: block;
    margin-bottom: 4px;
  }
  .license-content p {
    margin: 4px 0 10px;
    line-height: 1.5;
  }
  .key-display-row {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 10px;
  }
  .license-code {
    font-family: var(--fontMono);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--headings);
    background: var(--cardBg);
    border: 1px solid var(--line);
    padding: 8px 16px;
    border-radius: 8px;
    letter-spacing: 0.05em;
  }
  .btn-copy {
    background: var(--primaryBg);
    color: var(--primaryText);
    border: none;
    border-radius: var(--btnRadius);
    padding: 8px 18px;
    font-family: var(--fontDisplay);
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
    transition: transform .15s ease, opacity .15s ease;
  }
  .btn-copy:hover {
    transform: translateY(-1px);
    opacity: 0.95;
  }
  .btn-copy.copied {
    background: #1F9D55 !important;
    color: #FFFFFF !important;
  }

  /* GUIDE SECTION */
  .guide-section {
    max-width: 1000px;
    margin: 0 auto 70px;
    text-align: center;
  }
  .eyebrow {
    font-family: var(--fontMono);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--primaryHoverBg);
    font-weight: 700;
    display: block;
    margin-bottom: 8px;
  }
  .guide-steps {
    display: grid;
