---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Hero from '../../components/Hero.astro';
import Steps from '../../components/Steps.astro';
import FeatureZigzag from '../../components/FeatureZigzag.astro';
import UspBanner from '../../components/UspBanner.astro';
import Pricing from '../../components/Pricing.astro';
import Testimonials from '../../components/Testimonials.astro';
import FinalCta from '../../components/FinalCta.astro';
import Footer from '../../components/Footer.astro';
import { products, type ProductConfig } from '../../data/products';

export function getStaticPaths() {
  const paths = [];
  for (const product of Object.values(products)) {
    // Route principale par slug
    paths.push({
      params: { product: product.slug },
      props: { product },
    });

    // Alias pour rétrocompatibilité (ex: cooking-chief-kitchen-ai)
    if (product.aliases) {
      for (const alias of product.aliases) {
        paths.push({
          params: { product: alias },
          props: { product },
        });
      }
    }
  }
  return paths;
}

interface Props {
  product: ProductConfig;
}

const { product } = Astro.props;
---

<Layout
  title={product.metaTitle}
  description={product.metaDescription}
  theme={product.theme}
>
  <Navbar
    brandName={product.name}
    paymentUrl={product.paymentUrl}
  />
  <Hero
    eyebrow={product.hero.eyebrow}
    headline={product.hero.headline}
    subheadline={product.hero.subheadline}
    primaryCtaText={product.hero.primaryCtaText}
    secondaryCtaText={product.hero.secondaryCtaText}
    paymentUrl={product.paymentUrl}
    trustBadge={product.hero.trustBadge}
    bgImage={product.hero.bgImage}
  />
  <Steps
    eyebrow={product.stepsSection.eyebrow}
    title={product.stepsSection.title}
    subtitle={product.stepsSection.subtitle}
    steps={product.stepsSection.steps}
  />
  <FeatureZigzag features={product.featuresSection.features} />
  <UspBanner
    eyebrow={product.uspBanner.eyebrow}
    title={product.uspBanner.title}
    description={product.uspBanner.description}
  />
  <Pricing
    eyebrow={product.pricingSection.eyebrow}
    title={product.pricingSection.title}
    cardEyebrow={product.pricingSection.cardEyebrow}
    priceHint={product.pricingSection.priceHint}
    guaranteeHint={product.pricingSection.guaranteeHint}
    paymentUrl={product.paymentUrl}
    tiers={product.pricingSection.tiers}
    featuresIncluded={product.pricingSection.featuresIncluded}
  />
  <Testimonials
    eyebrow={product.testimonialsSection.eyebrow}
    title={product.testimonialsSection.title}
    testimonials={product.testimonialsSection.testimonials}
  />
  <FinalCta
    eyebrow={product.finalCta.eyebrow}
    title={product.finalCta.title}
    subtitle={product.finalCta.subtitle}
    buttonText={product.finalCta.buttonText}
    languagesText={product.finalCta.languagesText}
    paymentUrl={product.paymentUrl}
  />
  <Footer productName={product.name} />
</Layout>
