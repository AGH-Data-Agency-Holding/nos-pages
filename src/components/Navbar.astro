---
interface Props {
  brandName: string;
  paymentUrl: string;
  freeTrialText?: string;
  downloadText?: string;
}

const {
  brandName,
  paymentUrl,
  freeTrialText = "Essai gratuit 7j",
  downloadText = "Télécharger",
} = Astro.props;
---

<header class="navbar-header">
  <div class="wrap nav">
    <a class="brand" href="#top">
      <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M24 6c-6 0-9 5-9 10 0 3 1.3 5 3 6.5-2 1-3 3-3 5.5v4h18v-4c0-2.5-1-4.5-3-5.5 1.7-1.5 3-3.5 3-6.5 0-5-3-10-9-10Z" fill="currentColor"/>
        <rect x="15" y="34" width="18" height="4" rx="2" fill="currentColor"/>
      </svg>
      <span>{brandName}</span>
    </a>
    <nav class="nav-links" aria-label="Navigation principale">
      <a href="#fonctionnalites">Fonctionnalités</a>
      <a href="#comment">Comment ça marche</a>
      <a href="#tarif">Tarif</a>
    </nav>
    <div class="nav-cta-group">
      <a class="btn btn-ghost" href="#tarif">{freeTrialText}</a>
      <a class="btn btn-primary" href={paymentUrl}>{downloadText}</a>
    </div>
  </div>
</header>

<style>
  .navbar-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(253, 238, 225, .88);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: "Fraunces", serif;
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--charcoal);
    text-decoration: none;
  }
  .brand svg {
    width: 32px;
    height: 32px;
    color: var(--flame);
  }
  .nav-links {
    display: flex;
    gap: 30px;
    font-size: .92rem;
    font-weight: 500;
  }
  .nav-links a {
    text-decoration: none;
    color: var(--ink);
    transition: color .15s ease;
  }
  .nav-links a:hover {
    color: var(--flame);
  }
  .nav-cta-group {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  @media (max-width: 780px) {
    .nav-links { display: none; }
  }
  @media (max-width: 640px) {
    .nav-cta-group .btn-ghost { display: none; }
    .nav-cta-group .btn-primary { padding: 10px 15px; font-size: 0.84rem; white-space: nowrap; }
  }
</style>
