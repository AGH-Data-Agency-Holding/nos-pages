---
import { APP_CHANNELS } from '../../data/channels';

interface Props {
  channel: 'direct' | 'jvzoo' | 'clickbank' | 'hotmart';
  appSlug: string;
}

const { channel, appSlug } = Astro.props;
const config = APP_CHANNELS[appSlug];
const jvzoo = config?.jvzoo;
const clickbank = config?.clickbank;
const hotmart = config?.hotmart;
---

{channel === 'jvzoo' && jvzoo && (
  <div class="jvzoo-hosted-box" style="margin: 36px auto 0; max-width: 560px; padding: 24px 20px; background: rgba(255,255,255,0.85); border: 1.5px solid var(--line, #E0E0E0); border-radius: 16px; text-align: center; box-shadow: var(--shadow, 0 8px 24px rgba(0,0,0,0.06));">
    <span style="display: block; font-size: 0.76rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; opacity: 0.8; margin-bottom: 8px;">Paiement Sécurisé Vérifié JVZoo</span>
    <div style="margin: 14px auto; display: flex; justify-content: center; align-items: center;">
      <a href={`https://www.jvzoo.com/b/0/${jvzoo.primaryId}/1`} target="_blank" rel="noopener noreferrer" style="display: inline-block;">
        <img src={`https://i.jvzoo.com/b/0/${jvzoo.primaryId}/1`} alt="Buy Now on JVZoo" border="0" />
      </a>
    </div>
    <img src={`https://i.jvzoo.com/open/${jvzoo.primaryId}`} width="1" height="1" style="display:none;" alt="JVZoo Tracking Pixel" />
    <p style="font-size: 0.84rem; opacity: 0.8; margin-top: 10px; line-height: 1.5;">Paiement 100% sécurisé via JVZoo. Confirmation instantanée et activation immédiate.</p>
  </div>
)}

{channel === 'clickbank' && clickbank && (
  <div class="clickbank-hosted-box" style="margin: 36px auto 0; max-width: 580px; padding: 24px 22px; background: #FFFFFF; border: 2px solid #16a34a; border-radius: 16px; text-align: center; box-shadow: 0 10px 30px rgba(22,163,74,0.12);">
    <div style="display: inline-flex; align-items: center; gap: 6px; background: #dcfce7; color: #15803d; font-size: 0.78rem; font-weight: 700; padding: 5px 12px; border-radius: 100px; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 12px;">
      Garantie Satisfait ou Remboursé 60 Jours ClickBank
    </div>
    
    <div style="margin: 10px 0 16px; padding: 14px; background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 12px; text-align: left;">
      <div style="font-size: 0.82rem; font-weight: 700; color: #16a34a; text-transform: uppercase; margin-bottom: 4px;">🎁 Bonus Numérique Inclus Offert :</div>
      <div style="font-size: 0.92rem; font-weight: 600; color: #0f172a; margin-bottom: 4px;">{clickbank.bonusTitle}</div>
      <p style="font-size: 0.82rem; color: #475569; margin: 0; line-height: 1.45;">{clickbank.bonusDescription}</p>
    </div>

    <div style="margin: 16px auto; display: flex; justify-content: center;">
      <a href={clickbank.paymentUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="padding: 16px 36px; font-size: 1.08rem; font-weight: 700; border-radius: 100px; text-decoration: none; display: inline-flex; align-items: center; gap: 8px;">
        Commander en Sécurité via ClickBank →
      </a>
    </div>
    <p style="font-size: 0.82rem; color: #64748b; margin-top: 8px; line-height: 1.4;">Paiement sécurisé crypté SSL 256-bit opéré par ClickBank. Accès instantané à l'application et au bonus.</p>
  </div>
)}

{channel === 'hotmart' && hotmart && (
  <div class="hotmart-hosted-box" style="margin: 36px auto 0; max-width: 560px; padding: 24px 20px; background: #FFFFFF; border: 1.5px solid #ea580c; border-radius: 16px; text-align: center; box-shadow: 0 8px 24px rgba(234,88,12,0.08);">
    <span style="display: block; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #ea580c; margin-bottom: 8px;">Paiement Multi-Devises Sécurisé Hotmart</span>
    <div style="margin: 14px auto; display: flex; justify-content: center; align-items: center;">
      <a href={hotmart.paymentUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary" style="padding: 15px 32px; font-size: 1.02rem; font-weight: 700; border-radius: 100px; text-decoration: none;">
        Accéder via Hotmart Sécurisé →
      </a>
    </div>
    <p style="font-size: 0.84rem; color: #475569; margin-top: 8px; line-height: 1.45;">Paiement accepté en EUR, USD, MAD, BRL. Livraison immédiate de votre clé et lien de téléchargement.</p>
  </div>
)}
