---
const price = "29,99 €";
const paymentUrl = "https://aghhol.gumroad.com/l/mental-heath-ai";

// ⚠️ Noms de "variant" par hypothèse (même schéma que les apps précédentes).
// À CONFIRMER via l'onglet "Versions" du produit "mental-heath-ai" sur Gumroad
// avant de considérer cette intégration comme validée.
const tiers = [
  { name: "Serein 1 mois", price: "29,99 €", variant: "1 Month License", featured: false },
  { name: "Serein 3 mois", price: "59,99 €", variant: "3 Months License", featured: false },
  { name: "Serein 6 mois", price: "119,99 €", variant: "6 Months License", featured: false },
  { name: "Serein 12 mois", price: "199,99 €", variant: "12 Months License", featured: true, badge: "Le plus choisi" },
  { name: "Serein À vie", price: "399,99 €", variant: "LIFETIME", featured: false },
];

const testimonialProfiles = [
  { initials: "IM", profile: "Inès", profession: "Responsable boutique", problem: "Je cherchais un espace simple pour mettre des mots sur mes journées difficiles.", benefit: "Les exercices guidés m'aident à retrouver un peu de calme sans bouleverser mon quotidien." },
  { initials: "TH", profile: "Thomas", profession: "Développeur web", problem: "Mon stress revenait souvent et je ne savais pas comment suivre son évolution.", benefit: "Le suivi d'humeur et le journal m'aident à repérer ce qui me fait du bien et à rester régulier." },
  { initials: "YA", profile: "Yasmine", profession: "Photographe indépendante", problem: "Je doutais qu'un assistant IA puisse vraiment comprendre mes préoccupations.", benefit: "Les échanges sont accessibles et les suggestions m'aident à avancer à mon rythme." },
];
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Calmenow — Votre coach IA de bien-être mental, 24h/24</title>
  <meta name="description" content="Calmenow (Mindful AI) : votre compagnon IA pour le bien-être mental, disponible 24h/24. Suivi d'humeur, respiration guidée, méditations et journal, basés sur la TCC, 100% privé et chiffré." />
  <link rel="icon" type="image/png" href="/images/logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

  <!-- HEADER -->
  <header class="site-header">
    <div class="wrap header-inner">
      <a href="#top" class="brand">
        <img src="/images/logo.png" alt="Calmenow" class="brand-mark" />
        <span class="brand-name">Calme<em>now</em></span>
      </a>
      <nav class="nav">
        <a href="#fonctionnalites">Fonctionnalités</a>
        <a href="#confidentialite">Confidentialité</a>
        <a href="#tarif">Tarif</a>
      </nav>
      <!-- Bouton essai gratuit : lien/logique à configurer par l'équipe dev, ne pas connecter au checkout existant -->
      <a href="#" class="btn btn-ghost btn-small">Essai gratuit 7j</a>
      <a href={paymentUrl} class="btn btn-primary btn-small" data-gumroad-overlay-checkout="true">Essayer — {price}</a>
    </div>
  </header>

  <main id="top">

    <!-- HERO -->
    <section class="hero">
      <div class="blob blob-1" aria-hidden="true"></div>
      <div class="blob blob-2" aria-hidden="true"></div>
      <div class="wrap hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">Un quotidien plus apaisé, guidé par l'IA</p>
          <h1>Retrouvez votre <span class="ink">équilibre</span>, à votre rythme.</h1>
          <p class="hero-sub">
            Stress, anxiété, ou simplement besoin d'être écouté : Calmenow est un compagnon IA disponible 24h/24, conçu pour comprendre votre culture, vos valeurs et votre langue — sans jugement, avec des méthodes reconnues comme la TCC.
          </p>
          <div class="hero-ctas">
            <a href={paymentUrl} class="btn btn-primary" data-gumroad-overlay-checkout="true">Commencer maintenant</a>
            <a href="#fonctionnalites" class="btn btn-ghost">Voir les fonctionnalités</a>
          </div>
          <p class="hero-microcopy">Application offline-first · Disponible en français, anglais, arabe et espagnol · Satisfait ou remboursé sous 30 jours · Essayez gratuitement pendant 7 jours</p>
        </div>
        <div class="hero-visual">
          <img src="/images/phone_hero.png" alt="Application Calmenow, votre IA de bien-être mental" class="hero-phone" />
        </div>
      </div>
    </section>

    <!-- STATS BAND -->
    <section class="stats-band">
      <div class="wrap stats-inner">
        <div class="stat">
          <span class="stat-num">24/7</span>
          <span class="stat-label">un compagnon IA toujours disponible</span>
        </div>
        <div class="stat">
          <span class="stat-num">60+</span>
          <span class="stat-label">langues et cultures prises en compte</span>
        </div>
        <div class="stat">
          <span class="stat-num">30</span>
          <span class="stat-label">jours pour construire une résilience durable</span>
        </div>
        <div class="stat">
          <span class="stat-num">100%</span>
          <span class="stat-label">privé et chiffré</span>
        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section id="fonctionnalites" class="features">
      <div class="wrap">
        <p class="eyebrow center">Fonctionnalités clés</p>
        <h2 class="section-title center">Un espace complet pour prendre soin de votre esprit</h2>
      </div>

      <!-- Feature 1: Mood tracking -->
      <div class="feature-row wrap">
        <div class="feature-text">
          <span class="feature-tag">Suivi d'humeur quotidien</span>
          <h3>Un check-in rapide, chaque jour</h3>
          <p>En quelques secondes, notez comment vous vous sentez et suivez l'évolution de votre humeur sur la semaine. Calmenow vous aide à repérer les tendances avant qu'elles ne deviennent un problème.</p>
          <ul class="feature-list">
            <li>Check-in d'humeur en un tap (triste, ok, bien, super, calme)</li>
            <li>Graphique d'évolution sur les 7 derniers jours</li>
            <li>Rappels personnalisés pour votre routine bien-être</li>
          </ul>
        </div>
        <div class="feature-image">
          <img src="/images/phone_mood.png" alt="Suivi d'humeur quotidien dans Calmenow" loading="lazy" />
        </div>
      </div>

      <!-- Feature 2: Journal -->
      <div class="feature-row wrap reverse">
        <div class="feature-text">
          <span class="feature-tag">Journal guidé par IA</span>
          <h3>Écrivez librement, avec un peu d'aide</h3>
          <p>Quand les mots manquent, des questions générées par l'IA vous aident à explorer ce que vous ressentez — "Pourquoi vous sentez-vous ainsi ?", "Qu'est-ce qui a déclenché cette émotion ?" — et à tagger vos émotions pour mieux les comprendre.</p>
          <ul class="feature-list">
            <li>Suggestions IA pour débloquer l'écriture</li>
            <li>Tags d'émotions (stress, anxiété, calme, joie...)</li>
            <li>Entrées privées, visibles par vous seul</li>
          </ul>
          <!-- TODO: visuel IA manquant pour cette section, à fournir -->
        </div>
        <div class="feature-image">
          <img src="/images/phone_journal.png" alt="Journal guidé par IA dans Calmenow" loading="lazy" />
        </div>
      </div>

      <!-- Feature 3: Meditation -->
      <div class="feature-row wrap">
        <div class="feature-text">
          <span class="feature-tag">Méditations & respiration guidée</span>
          <h3>Un calme immédiat, à portée de main</h3>
          <p>Des séances de méditation guidées avec des voix familières et des exercices de respiration pour un apaisement instantané — le matin pour bien démarrer, le soir pour relâcher la journée.</p>
          <ul class="feature-list">
            <li>Bibliothèque de méditations guidées (matin, calme, sommeil)</li>
            <li>Exercices de respiration pour un soulagement immédiat</li>
            <li>Voix locales et familières, adaptées à votre culture</li>
          </ul>
        </div>
        <div class="feature-image">
          <img src="/images/phone_meditation.png" alt="Séance de méditation guidée dans Calmenow" loading="lazy" />
        </div>
      </div>
    </section>

    <!-- CALLOUT / PRIVACY -->
    <section id="confidentialite" class="callout">
      <div class="wrap callout-inner">
        <div class="callout-image">
          <img src="/images/illustration_privacy.png" alt="Confidentialité et chiffrement des données Calmenow" loading="lazy" />
        </div>
        <div class="callout-text">
          <h2>Vos pensées vous appartiennent</h2>
          <p>Tout ce que vous partagez avec Calmenow — votre humeur, votre journal, vos conversations — est entièrement chiffré et reste privé. Aucun jugement, aucun partage : juste un espace sûr pour vous.</p>
        </div>
      </div>
    </section>

    <!-- PRICING -->
    <section id="tarif" class="pricing">
      <div class="wrap">
        <div class="pricing-card">
          <p class="eyebrow center">Tarif</p>
          <h2 class="section-title center">Un prix simple, pas d'abonnement caché.</h2>
          <p class="price-hint">Cliquez sur une licence pour ouvrir directement le paiement correspondant.</p>
          <p class="price-hint">Essayez gratuitement pendant 7 jours · Satisfait ou remboursé sous 30 jours</p>
          <div class="price-list">
            {tiers.map((tier) => (
              <a
                class={`price-row ${tier.featured ? "featured" : ""}`}
                href={`${paymentUrl}?variant=${encodeURIComponent(tier.variant)}`}
                data-gumroad-overlay-checkout="true"
              >
                <span class="price-row-label-wrap">
                  <span class="price-row-label">{tier.name}</span>
                  {tier.badge && <span class="price-row-badge">{tier.badge}</span>}
                </span>
                <span class="price-row-right">
                  <span class="price-row-amount">{tier.price}</span>
                  <span class="price-row-arrow">→</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS -->
    <section class="testimonials">
      <div class="wrap">
        <p class="eyebrow center">Preuve sociale</p>
        <h2 class="section-title center">Un peu plus de calme au quotidien.</h2>
        <div class="testimonials-grid">
          {testimonialProfiles.map((testimonial, index) => (
            <article class="testimonial-card">
              <div class="testimonial-head">
          <img class="testimonial-avatar" src={`https://i.pravatar.cc/96?img=${28 + index}`} alt={`Photo de profil de ${testimonial.profile}`} loading="lazy" />
                <div>
                  <strong>{testimonial.profile}</strong>
                  <span>{testimonial.profession}</span>
                </div>
              </div>
              <div class="testimonial-stars" aria-label="Note : 5 sur 5">★★★★★</div>
              <p>{testimonial.problem}</p>
              <p>{testimonial.benefit}</p>
            </article>
          ))}
        </div>
        <!-- Témoignages fictifs de maquettage — remplacer par de vrais avis clients avant mise en prod -->
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="final-cta">
      <div class="wrap final-cta-inner">
        <h2>Prenez un moment pour votre santé mentale, aujourd'hui.</h2>
        <p>Rejoignez Calmenow et commencez à construire une résilience durable, à votre rythme et dans votre langue.</p>
        <a href={paymentUrl} class="btn btn-light" data-gumroad-overlay-checkout="true">Commencer maintenant — {price}</a>
      </div>
    </section>

  </main>

  <!-- FOOTER -->
  <footer class="site-footer">
    <div class="wrap footer-inner">
      <div class="footer-brand">
        <img src="/images/logo.png" alt="Calmenow" class="brand-mark" loading="lazy" />
        <span class="brand-name">Calme<em>now</em></span>
      </div>
      <p class="footer-note">Calmenow est un outil de bien-être et ne remplace pas un avis médical ou psychologique professionnel. En cas de détresse, consultez un professionnel de santé ou un service d'urgence.</p>
      <p class="footer-copy">© {new Date().getFullYear()} AGH Data Agency Holding SA. Tous droits réservés.</p>
    </div>
  </footer>

  <style>
    :root {
      --ink: #17252B;
      --teal: #0E6E55;
      --teal-deep: #0A4A3A;
      --purple: #6C5CE7;
      --navy: #12283B;
      --mint: #EAFBF3;
      --cream: #FAFAF8;
      --paper: #FFFFFF;
      --slate: #5A6B66;
      --line: #E2E8E4;
      --radius: 20px;
      --shadow: 0 14px 34px -14px rgba(14, 110, 85, 0.25);
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; overflow-x: hidden; width: 100%; }
    body {
      margin: 0;
      width: 100%;
      overflow-x: hidden;
      font-family: 'Inter', -apple-system, sans-serif;
      color: var(--ink);
      background: var(--cream);
      -webkit-font-smoothing: antialiased;
    }
    h1, h2, h3, h4 {
      font-family: 'Poppins', sans-serif;
      margin: 0;
      line-height: 1.15;
      letter-spacing: -0.01em;
      color: var(--ink);
    }
    p { margin: 0; color: var(--slate); line-height: 1.65; }
    a { text-decoration: none; color: inherit; }
    ul { margin: 0; padding: 0; list-style: none; }
    img { max-width: 100%; display: block; }
    em { font-style: normal; color: var(--teal); }

    .wrap {
      max-width: 1160px;
      margin: 0 auto;
      padding: 0 28px;
    }

    /* Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 14px 28px;
      border-radius: 999px;
      font-family: 'Poppins', sans-serif;
      font-weight: 600;
      font-size: 0.96rem;
      transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
      white-space: nowrap;
    }
    .btn-primary {
      background: var(--teal);
      color: #fff;
      box-shadow: 0 8px 20px -8px rgba(14, 110, 85, 0.55);
    }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 12px 26px -8px rgba(14, 110, 85, 0.6); }
    .btn-small { padding: 10px 20px; font-size: 0.86rem; }
    .btn-ghost {
      border: 1.5px solid var(--line);
      color: var(--ink);
      background: transparent;
    }
    .btn-ghost:hover { border-color: var(--teal); background: rgba(14,110,85,0.05); }
    .btn-light {
      background: #fff;
      color: var(--teal-deep);
      box-shadow: 0 8px 20px -8px rgba(0,0,0,0.3);
    }
    .btn-light:hover { transform: translateY(-2px); }

    /* Header */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(250, 250, 248, 0.86);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--line);
    }
    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-top: 14px;
      padding-bottom: 14px;
    }
    .brand { display: flex; align-items: center; gap: 10px; }
    .brand-mark { width: 32px; height: 32px; object-fit: contain; }
    .brand-name { font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 1.1rem; }
    .nav { display: flex; gap: 30px; }
    .nav a { font-size: 0.92rem; font-weight: 500; color: var(--slate); }
    .nav a:hover { color: var(--teal); }

    /* Hero */
    .hero { position: relative; padding: 76px 0 40px; overflow: hidden; }
    .blob {
      position: absolute;
      border-radius: 50%;
      filter: blur(10px);
      opacity: 0.5;
      pointer-events: none;
    }
    .blob-1 {
      width: 420px; height: 420px;
      background: radial-gradient(circle, var(--mint) 0%, transparent 70%);
      top: -160px; left: -140px;
    }
    .blob-2 {
      width: 380px; height: 380px;
      background: radial-gradient(circle, rgba(108,92,231,0.16) 0%, transparent 70%);
      top: 60px; right: -160px;
    }
    .hero-inner {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: 48px;
      align-items: center;
      position: relative;
      z-index: 1;
    }
    .eyebrow {
      font-family: 'Poppins', sans-serif;
      font-size: 0.82rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--purple);
      margin-bottom: 14px;
      display: block;
    }
    .eyebrow.center { text-align: center; }
    h1 { font-size: clamp(2.4rem, 4.2vw, 3.4rem); font-weight: 700; }
    h1 .ink { color: var(--teal); }
    .hero-sub {
      margin-top: 22px;
      font-size: 1.1rem;
      max-width: 480px;
    }
    .hero-ctas { display: flex; gap: 14px; margin-top: 32px; flex-wrap: wrap; }
    .hero-microcopy {
      margin-top: 18px;
      font-size: 0.85rem;
      color: #8B9A94;
    }

    .hero-visual { display: flex; justify-content: center; }
    .hero-phone {
      width: 100%;
      max-width: 300px;
      border-radius: 32px;
      box-shadow: var(--shadow);
    }

    /* Stats band */
    .stats-band {
      background: var(--navy);
      padding: 40px 0;
    }
    .stats-inner {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
    .stat { text-align: center; color: #fff; }
    .stat-num {
      display: block;
      font-family: 'Poppins', sans-serif;
      font-weight: 800;
      font-size: 2.2rem;
      color: #6EE7B7;
    }
    .stat-label {
      display: block;
      margin-top: 6px;
      font-size: 0.85rem;
      color: #C3D0CB;
      max-width: 200px;
      margin-left: auto;
      margin-right: auto;
    }

    /* Features */
    .features { padding: 90px 0 30px; }
    .section-title {
      font-size: clamp(1.7rem, 3vw, 2.3rem);
      font-weight: 700;
      max-width: 640px;
      margin: 10px auto 0;
    }
    .section-title.center { text-align: center; margin-left: auto; margin-right: auto; }

    .feature-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 56px;
      align-items: center;
      padding: 64px 0;
      border-bottom: 1px solid var(--line);
    }
    .feature-row:last-child { border-bottom: none; }
    .feature-row.reverse .feature-text { order: 2; }
    .feature-row.reverse .feature-image { order: 1; }

    .feature-tag {
      display: inline-block;
      font-family: 'Poppins', sans-serif;
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--purple);
      margin-bottom: 12px;
    }
    .feature-text h3 {
      font-size: 1.65rem;
      font-weight: 700;
      margin-bottom: 16px;
    }
    .feature-text > p { font-size: 1.02rem; margin-bottom: 20px; }
    .feature-list li {
      position: relative;
      padding-left: 26px;
      margin-bottom: 12px;
      font-size: 0.96rem;
      color: var(--slate);
    }
    .feature-list li::before {
      content: "";
      position: absolute;
      left: 0;
      top: 8px;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--teal);
    }
    .feature-image img {
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      max-width: 340px;
      margin: 0 auto;
    }

    /* Callout / Privacy */
    .callout {
      background: linear-gradient(180deg, var(--mint) 0%, #FFFFFF 100%);
      padding: 80px 0;
      margin: 40px 0;
    }
    .callout-inner {
      display: grid;
      grid-template-columns: 0.8fr 1.2fr;
      gap: 56px;
      align-items: center;
    }
    .callout-image img {
      border-radius: var(--radius);
      box-shadow: var(--shadow);
    }
    .callout-text h2 {
      font-size: clamp(1.7rem, 3vw, 2.3rem);
      font-weight: 700;
    }
    .callout-text p {
      margin-top: 18px;
      font-size: 1.05rem;
    }

    /* Pricing */
    .pricing { padding: 30px 0 90px; }
    .pricing-card {
      background: var(--paper);
      border-radius: 26px;
      padding: 48px 44px;
      max-width: 560px;
      margin: 0 auto;
      box-shadow: var(--shadow);
    }
    .pricing-card .eyebrow.center { margin-bottom: 10px; }
    .pricing-card .section-title.center { font-size: clamp(1.4rem, 2.6vw, 1.8rem); }
    .price-hint { text-align: center; font-size: 0.85rem; color: #8B9A94; margin-top: 12px; }
    .price-list {
      margin-top: 24px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .price-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 18px 22px;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: var(--cream);
      text-decoration: none;
      color: inherit;
      cursor: pointer;
      transition: border-color .15s ease, background .15s ease, transform .15s ease;
    }
    .price-row:hover { border-color: var(--teal); transform: translateY(-1px); }
    .price-row.featured {
      border: 1.5px solid var(--teal);
      background: rgba(14, 110, 85, 0.06);
    }
    .price-row.featured:hover { background: rgba(14, 110, 85, 0.1); }
    .price-row-label {
      font-weight: 600;
      font-size: 1rem;
      color: var(--ink);
    }
    .price-row-label-wrap {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .price-row-badge {
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: var(--teal-deep);
    }
    .price-row-right { display: flex; align-items: center; gap: 10px; }
    .price-row-amount {
      font-family: 'Poppins', sans-serif;
      font-weight: 800;
      font-size: 1.3rem;
      color: var(--teal);
      white-space: nowrap;
    }
    .price-row-arrow { font-size: 1.1rem; color: var(--teal); }

    /* Guarantee */
    .guarantee { padding: 0 0 90px; }
    .guarantee-inner {
      display: flex;
      align-items: center;
      gap: 26px;
      background: #EFF3F1;
      border-radius: var(--radius);
      padding: 34px 40px;
      max-width: 780px;
      margin: 0 auto;
    }
    .guarantee-icon { color: var(--teal); flex-shrink: 0; }
    .guarantee h3 { font-size: 1.1rem; font-weight: 700; margin-bottom: 6px; }
    .guarantee p { font-size: 0.92rem; }

    /* Testimonials */
    .testimonials { padding: 0 0 90px; }
    .testimonials-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }
    .testimonial-card {
      background: #fff;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 24px;
      box-shadow: 0 16px 36px -26px rgba(23, 37, 43, 0.32);
    }
    .testimonial-head { display: flex; align-items: center; gap: 12px; }
    .testimonial-avatar {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: #EFF3F1;
      color: var(--teal-deep);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
    }
    .testimonial-head strong,
    .testimonial-head span { display: block; }
    .testimonial-head strong { font-size: 0.95rem; }
    .testimonial-head span { margin-top: 3px; color: #71827B; font-size: 0.78rem; }
    .testimonial-stars { color: var(--teal); letter-spacing: 0.12em; margin: 18px 0 12px; }
    .testimonial-card p { color: #52625E; font-size: 0.9rem; line-height: 1.6; margin: 0 0 10px; }

    /* Final CTA */
    .final-cta {
      background: var(--navy);
      padding: 90px 0;
    }
    .final-cta-inner { text-align: center; max-width: 640px; margin: 0 auto; }
    .final-cta h2 { color: #fff; font-size: clamp(1.7rem, 3vw, 2.4rem); }
    .final-cta p { color: #C3D0CB; margin-top: 18px; font-size: 1.05rem; }
    .final-cta .btn { margin-top: 32px; }

    /* Footer */
    .site-footer { padding: 44px 0; }
    .footer-inner { text-align: center; }
    .footer-brand {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      margin-bottom: 16px;
    }
    .footer-note {
      font-size: 0.82rem;
      max-width: 540px;
      margin: 0 auto 10px;
      color: #8B9A94;
    }
    .footer-copy { font-size: 0.8rem; color: #A3AFA9; }

    /* Responsive */
    @media (max-width: 900px) {
      .hero-inner { grid-template-columns: 1fr; }
      .hero-visual { order: -1; margin-bottom: 10px; }
      .stats-inner { grid-template-columns: repeat(2, 1fr); }
      .feature-row { grid-template-columns: 1fr; gap: 30px; padding: 44px 0; }
      .feature-row.reverse .feature-text,
      .feature-row.reverse .feature-image { order: initial; }
      .callout-inner { grid-template-columns: 1fr; text-align: center; }
      .nav { display: none; }
      .guarantee-inner { flex-direction: column; text-align: center; }
      .testimonials-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 640px) {
      .stats-inner { grid-template-columns: 1fr 1fr; }
      .wrap { padding: 0 20px; }
      .hero { padding: 56px 0 30px; }
      .pricing-card { padding: 32px 24px; }
      .price-row { padding: 14px 16px; }
    }
  </style>

  <!-- Script du prestataire de paiement : détecte les liens pointant vers le domaine de paiement et ouvre le paiement en pop-up.
       is:inline est OBLIGATOIRE : sans ça, Astro bundle ce script externe via Vite, ce qui provoque une erreur CORS au chargement. -->
  <script src="https://gumroad.com/js/gumroad.js" is:inline></script>

</body>
</html>
